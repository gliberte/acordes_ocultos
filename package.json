{
  "name": "acordes-ocultos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts StoryVideo out/story.mp4 --props=src/data/story.json",
    "render:still": "remotion still src/index.ts StoryCover out/cover.png --props=src/data/story.json",
    "render:teaser": "remotion still src/index.ts StoryTeaser out/story_teaser.png --props=src/data/story.json",
    "teaser": "node scripts/generate-teaser.mjs",
    "render:carousel": "remotion render src/index.ts CarouselGrid out/carousel --props=src/data/carousel.json --sequence --image-format=png",
    "render:presentation": "remotion render src/index.ts PresentationVideo out/presentation.mp4 --props=src/data/presentation.json",
    "render:youtube": "remotion render src/index.ts YouTubeDocumentary out/youtube_documentary.mp4 --props=src/data/youtube/isabel-pantoja-marinero-de-luces.json",
    "render:youtube-thumb": "remotion still src/index.ts YouTubeThumbnail out/youtube_thumbnail.png",
    "render:special": "remotion render src/index.ts SpecialMontageVideo out/special_montage.mp4",
    "prepare:presentation": "node scripts/prepare-presentation.mjs",
    "create:story": "node scripts/create-story.mjs",
    "assets:plan": "node scripts/generate-assets.mjs --dry-run",
    "assets:generate": "node scripts/generate-assets.mjs",
    "publish:package": "node scripts/publish-package.mjs",
    "publish:presentation": "node scripts/publish-package.mjs --story src/data/presentation.json --video out/presentation.mp4",
    "publish:carousel": "node scripts/publish-carousel.mjs",
    "publish:dry-run": "node scripts/publish-package.mjs --dry-run",
    "publish:telegram": "node scripts/publish-package.mjs --skip-cloudflare --skip-supabase",
    "publish:cloud": "node scripts/publish-package.mjs --skip-telegram",
    "flow:login": "node scripts/flow-auth.mjs",
    "assets:flow": "node scripts/generate-flow-images.mjs",
    "backup:vault": "node scripts/backup-vault.mjs",
    "restore:vault": "node scripts/restore-vault.mjs",
    "vault:sync-videos": "node scripts/sync-vault-videos.mjs",
    "chronicle:html": "node scripts/generate-chronicle-html.mjs",
    "chronicle:compile": "node scripts/compile-chronicles.mjs",
    "chronicle:sync": "node scripts/sync-chronicles.mjs",
    "covers:optimize": "node scripts/generate-webp-covers.mjs",
    "images:optimize": "node scripts/optimize-web-images.mjs && node scripts/generate-webp-covers.mjs",
    "set:reel": "node scripts/set-instagram-reel.mjs",
    "sync:metrics": "node scripts/sync-instagram-metrics.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@google/genai": "^2.10.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0"
  }
}
