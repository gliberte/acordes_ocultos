---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title = 'Acordes Ocultos | Crónicas, Secretos y Leyendas de la Música',
  description = 'Descubre las microhistorias de alta tensión, las heridas y los milagros detrás de las canciones más icónicas de la historia.',
  image = '/assets/substack_header_banner.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Acordes Ocultos',
  section,
  tags = [],
  jsonLd,
  noindex = false
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://www.acordesocultos.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Ensure Open Graph and Twitter Card images are always absolute URLs (required by WhatsApp, Twitter/X, Facebook)
const fullImageURL = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(image, siteUrl).toString();

const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        (function() {
          function loadGA() {
            if (window._gaLoaded) return;
            window._gaLoaded = true;
            var script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(script);

            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          }

          if (localStorage.getItem('acordes_cookies_consent') === 'accepted') {
            loadGA();
          }

          window.addEventListener('acordes_consent_updated', function(e) {
            if (e.detail && e.detail.choice === 'accepted') {
              loadGA();
            }
          });
        })();
      </script>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/brand/acordes-ocultos-logo-sm.webp" />
    <meta name="generator" content={Astro.generator} />

    {image && (
      <link rel="preload" as="image" href={image} fetchpriority="high" />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:site_name" content="Acordes Ocultos" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:alt" content={title} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' && (
      <meta property="article:author" content={author} />
    )}
    {type === 'article' && section && (
      <meta property="article:section" content={section} />
    )}
    {type === 'article' && tags && tags.map((t) => (
      <meta property="article:tag" content={t.replace(/^#/, '')} />
    ))}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@acordesocultos" />
    <meta name="twitter:creator" content="@acordesocultos" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Structured Data (JSON-LD) for Google Rich Snippets & Discover -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Google Fonts (Non-Render-Blocking for Fast Mobile FCP/LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0908] text-neutral-100 antialiased selection:bg-amber-600 selection:text-white">
    <div class="fixed inset-0 pointer-events-none vinyl-radial -z-10"></div>
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- Vercel Web Analytics & Speed Insights -->
    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';

      inject();
      injectSpeedInsights();

      // Protect editorial images from right-click save and drag-and-drop
      document.addEventListener('contextmenu', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (
          target.tagName === 'IMG' ||
          target.tagName === 'PICTURE' ||
          target.closest('figure') ||
          target.closest('picture') ||
          target.hasAttribute('data-image-shield')
        ) {
          e.preventDefault();
        }
      });

      document.addEventListener('dragstart', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (
          target.tagName === 'IMG' ||
          target.tagName === 'PICTURE' ||
          target.closest('figure') ||
          target.closest('picture')
        ) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>
