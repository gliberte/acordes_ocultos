---
import Layout from '../layouts/Layout.astro';
import AdminPanel from '../components/AdminPanel';
import { getAllStories } from '../lib/stories';

if (!Astro.locals.isAdmin) return Astro.redirect('/admin/login');

const stories = await getAllStories({ includeHidden: true });

const adminStories = stories.map(s => ({
  id: s.id,
  slug: s.slug,
  title: s.title,
  artist: s.artist,
  coverUrl: s.coverUrl,
  categoryLabel: s.categoryLabel,
  instagramUrl: s.instagramUrl,
  publishedAt: s.publishedAt,
  content: s.content || '',
  extraImages: s.extraImages || [],
  isHidden: Boolean(s.isHidden)
}));
---

<Layout
  title="Panel de Administración | Acordes Ocultos"
  description="Gestor exclusivo de publicaciones y enlaces de Instagram de Acordes Ocultos."
>
  <AdminPanel
    client:only="react"
    initialStories={adminStories}
  />
</Layout>
