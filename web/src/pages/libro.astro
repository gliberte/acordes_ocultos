---
import Layout from '../layouts/Layout.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

const GUMROAD_BOOK_URL = 'https://acordesocultos.gumroad.com/l/acordes-ocultos-vol-1/LANZAMIENTO';
const GUMROAD_TIP_URL = 'https://acordesocultos.gumroad.com/l/ryhupd';

const PREVIEWS = [
  {
    image: '/book/preview/apertura-capitulo-interactivo.webp',
    title: 'Aperturas Editoriales con Enlaces a Instagram',
    tag: 'Enlaces a los Videos',
    subtitle: 'Acceso directo al Reel de Instagram de cada obra',
    description: 'Cada una de las 28 crónicas incluye un enlace directo al Reel de Instagram oficial (@acordesocultos72). Con un toque o clic en el PDF y EPUB, puedes acceder al video y escuchar la canción mientras descubres las circunstancias de su grabación (requiere conexión a internet).'
  },
  {
    image: '/book/preview/fotografia-archivo-abbey-road.webp',
    title: 'Archivo Histórico y Recreaciones Documentales',
    tag: 'Testimonio Visual Dual',
    subtitle: 'Fotos restauradas de época y recreaciones de estudio',
    description: 'El libro combina fotografías históricas reales de archivo rescatadas de sesiones en Abbey Road, Sun Studio o Western Recorders con recreaciones visuales rigurosas de época para ilustrar los pasajes íntimos narrados, identificando con honestidad cada material.'
  },
  {
    image: '/book/preview/diseno-editorial-california.webp',
    title: 'Maquetación para Lectura Inmersiva',
    tag: 'Diseño Editorial',
    subtitle: 'Tipografía descansada y proporciones clásicas',
    description: 'Una experiencia visual limpia y reposada. Tipografía serif calibrada para lecturas continuadas sin fatiga visual, márgenes proporcionados y letras capitulares que convierten cada página en un homenaje al libro de arte.'
  },
  {
    image: '/book/preview/documentacion-hemerografica.webp',
    title: 'Investigación y Fuentes de Archivo',
    tag: 'Método Documental',
    subtitle: 'Prensa histórica, testimonios de estudio y bibliografía',
    description: 'Las crónicas se construyen a partir de archivos hemerográficos de época, testimonios directos de músicos e ingenieros y bibliografía contrastada. Cada capítulo detalla sus fuentes documentales y mantenemos un canal abierto para revisar y corregir cualquier dato.'
  },
  {
    image: '/book/preview/narrativa-y-contexto-historico.webp',
    title: 'Narrativa en Actos Dramáticos',
    tag: 'Pulso Literario',
    subtitle: 'Estructura cinematográfica y tensión poética',
    description: 'Las crónicas no son fichas biográficas frías: se construyen con prólogo de inmersión, actos con tensión progresiva y un cierre reflexivo que indaga en la fragilidad humana, el miedo y la catarsis artística.'
  },
  {
    image: '/book/preview/indice-general.webp',
    title: '241 Páginas de Navegación Fluida',
    tag: 'Edición Completa',
    subtitle: 'Índice interactivo para saltar entre obras con un toque',
    description: 'Tanto en la versión PDF como en la edición EPUB, la tabla de contenidos cuenta con hipervínculos directos para que puedas saltar de inmediato al artista, época o canción que desees explorar en cada momento.'
  }
];

const SECTIONS = [
  {
    part: 'Parte I',
    title: 'Cuando una canción encuentra su camino',
    theme: 'La chispa del azar y las audacias de estudio',
    description: 'Una voz invitada, una grabación que cambia de rumbo, una melodía que cruza una frontera. A veces una canción empieza a crecer antes de que nadie sepa hasta dónde llegará.',
    chapters: [
      { num: '01', title: 'The Great Gig in the Sky', artist: 'Pink Floyd', slug: 'pink-floyd-the-great-gig-in-the-sky', highlight: 'El lamento de las treinta libras que cambió la historia del rock en Abbey Road' },
      { num: '02', title: "That's All Right", artist: 'Elvis Presley', slug: 'elvis-presley-thats-all-right-acordes-ocultos', highlight: 'La improvisación espontánea en Sun Studio que encendió una nueva era' },
      { num: '03', title: 'Eres tú', artist: 'Mocedades', slug: 'mocedades-eres-tu', highlight: 'Una canción en español al otro lado del mundo' },
      { num: '04', title: 'California Dreamin’', artist: 'The Mamas & The Papas', slug: 'the-mamas-and-the-papas-california-dreamin-acordes-ocultos', highlight: 'California evocada desde el invierno de Nueva York' },
      { num: '05', title: 'Like a Rolling Stone', artist: 'Bob Dylan', slug: 'bob-dylan-like-a-rolling-stone-acordes-ocultos', highlight: 'El órgano accidental de Al Kooper en Columbia Studios' },
      { num: '06', title: 'My Heart Will Go On', artist: 'Céline Dion', slug: 'celine-dion-my-heart-will-go-on', highlight: 'La voz que quedó en la primera maqueta y conquistó el cine' },
      { num: '07', title: 'Bohemian Rhapsody', artist: 'Queen', slug: 'queen-bohemian-rhapsody-forjados-en-el-barro', highlight: 'La apuesta que cambió la vida de Queen al borde de la quiebra' }
    ]
  },
  {
    part: 'Parte II',
    title: 'Lo que cantamos a quienes queremos',
    theme: 'La intimidad de la casa, los hijos y las despedidas',
    description: 'Hay canciones que se parecen a una conversación pendiente. En ellas caben un hijo que quiere marcharse, el recuerdo de un barrio, una promesa y la falta que nos hace alguien.',
    chapters: [
      { num: '08', title: 'Father and Son', artist: 'Cat Stevens', slug: 'cat-stevens-father-and-son', highlight: 'El hijo que necesitaba marcharse y el diálogo entre generaciones' },
      { num: '09', title: 'Adiós, chico de mi barrio', artist: 'Tormenta', slug: 'tormenta-adios-chico-de-mi-barrio-acordes-ocultos', highlight: 'La despedida adolescente y la memoria viva del barrio' },
      { num: '10', title: 'Lovin’ You', artist: 'Minnie Riperton', slug: 'minnie-riperton-lovin-you-acordes-ocultos', highlight: 'La canción de cuna luminosa que lleva el nombre de Maya' },
      { num: '11', title: 'Te quise, te quiero y te querré', artist: 'Manolo Galván', slug: 'manolo-galvan-te-quise-te-quiero-y-te-querre-acordes-ocultos', highlight: 'El amor que cruzó el océano y encontró una nueva patria' },
      { num: '12', title: 'Time in a Bottle', artist: 'Jim Croce', slug: 'jim-croce-time-in-a-bottle-acordes-ocultos', highlight: 'El tiempo que Jim quería guardar para su hijo antes del adiós' },
      { num: '13', title: 'Against the Wind', artist: 'Bob Seger', slug: 'bob-seger-against-the-wind', highlight: 'Los años, la juventud y el oficio de correr con el viento en contra' },
      { num: '14', title: 'Amor Eterno', artist: 'Rocío Dúrcal & Juan Gabriel', slug: 'rocio-durcal-amor-eterno-catedrales-de-leyenda', highlight: 'La voz de Rocío y la plegaria compartida por quienes ya no están' }
    ]
  },
  {
    part: 'Parte III',
    title: 'Voces frente al silencio',
    theme: 'Cuando cantar es también hacerse escuchar',
    description: 'La música también escucha lo que ocurre en la calle. Estas crónicas reúnen voces que se acercaron al miedo, a la injusticia y a la guerra, y encontraron distintas maneras de responder.',
    chapters: [
      { num: '15', title: 'The Sound of Silence', artist: 'Simon & Garfunkel', slug: 'simon-and-garfunkel-the-sound-of-silence', highlight: 'El rescate eléctrico de una canción que había nacido en penumbra' },
      { num: '16', title: 'Another Brick in the Wall (Part 2)', artist: 'Pink Floyd', slug: 'pink-floyd-another-brick-in-the-wall-part-2', highlight: 'Las voces escolares que salieron del aula y recorrieron el mundo' },
      { num: '17', title: 'Gimme Shelter', artist: 'The Rolling Stones', slug: 'the-rolling-stones-gimme-shelter', highlight: 'El grito desgarrador de Merry Clayton en la madrugada de 1969' },
      { num: '18', title: 'Todo cambia', artist: 'Mercedes Sosa', slug: 'mercedes-sosa-todo-cambia-catedrales-de-leyenda', highlight: 'Una voz a la que volver tras el silencio y la distancia del exilio' },
      { num: '19', title: 'Zombie', artist: 'The Cranberries', slug: 'the-cranberries-zombie-acordes-ocultos', highlight: 'El clamor de Dolores O’Riordan en memoria de las víctimas de Warrington' },
      { num: '20', title: 'From a Distance', artist: 'Bette Midler & Julie Gold', slug: 'bette-midler-from-a-distance', highlight: 'La canción íntima de Julie Gold que encontró la voz de Bette Midler' },
      { num: '21', title: 'Redemption Song', artist: 'Bob Marley', slug: 'bob-marley-redemption-song-destellos-de-gloria', highlight: 'Marley a solas con una guitarra acústica y su testamento de libertad' }
    ]
  },
  {
    part: 'Parte IV',
    title: 'Seguir adelante',
    theme: 'El regreso al escenario, la resistencia y la gratitud',
    description: 'Después del escenario quedan el cansancio, las despedidas y las ganas de volver a empezar. Al final, entre lo que perdemos y lo que todavía podemos cuidar, una canción nos invita a dar las gracias.',
    chapters: [
      { num: '22', title: 'Piece of My Heart', artist: 'Janis Joplin', slug: 'janis-joplin-piece-of-my-heart-destellos-de-gloria', highlight: 'Una voz indomable que desbordaba el escenario en cada entrega' },
      { num: '23', title: 'Baker Street', artist: 'Gerry Rafferty', slug: 'gerry-rafferty-baker-street-acordes-ocultos', highlight: 'El solo de saxo que nació entre litigios y esperas en Londres' },
      { num: '24', title: 'Un beso y una flor', artist: 'Nino Bravo', slug: 'nino-bravo-un-beso-y-una-flor-destellos-de-gloria', highlight: 'El equipaje luminoso de una voz inmortal antes de la carretera' },
      { num: '25', title: 'It’s a Long Way to the Top', artist: 'AC/DC', slug: 'acdc-its-a-long-way-to-the-top-acordes-ocultos', highlight: 'La gaita de Bon Scott que encontró su lugar en la historia del rock' },
      { num: '26', title: 'Marinero de Luces', artist: 'Isabel Pantoja & José Luis Perales', slug: 'isabel-pantoja-marinero-de-luces-acordes-ocultos', highlight: 'Volver a cantar desde el luto ante un país conmovido' },
      { num: '27', title: 'The Boxer', artist: 'Simon & Garfunkel', slug: 'simon-and-garfunkel-the-boxer', highlight: 'El pulso obstinado de quien cae en el cuadrilátero y sigue en pie' },
      { num: '28', title: 'Vive', artist: 'José María Napoleón', slug: 'jose-maria-napoleon-vive', highlight: 'La canción que aprendió a dar las gracias por el camino recorrido' }
    ]
  }
];

const totalChapters = SECTIONS.reduce((acc, s) => acc + s.chapters.length, 0);
---

<Layout
  title="Libro Oficial: Acordes Ocultos — Volumen 01 | 28 Historias Humanas detrás de la Música"
  description="Edición digital de colección (PDF interactivo de 241 páginas + EPUB) con 28 crónicas documentales completas, fotografías de archivo y enlaces directos a los videos de cada historia."
  image="/book/portada-volumen-01.jpg"
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 space-y-16">

    <!-- Hero Section -->
    <header class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#1c1813] via-[#12100e] to-[#0a0908] border border-amber-500/40 p-8 sm:p-14 shadow-2xl shadow-amber-950/40">
      <div class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full border border-amber-500/10 pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-center gap-10 lg:gap-14">
        <!-- Visual Book Cover: Physical 3D Mockup con la Portada Oficial -->
        <div class="w-64 sm:w-72 shrink-0 flex flex-col items-center">
          <div class="relative w-full drop-shadow-[0_20px_40px_rgba(0,0,0,0.9)] transform hover:-translate-y-1.5 transition-all duration-300 group">
            <img
              src="/book/libro-fisico-3d-hd.webp"
              alt="Edición Oficial: Acordes Ocultos — Volumen 01 en perspectiva física 3D con portada oficial y 241 páginas"
              width="869"
              height="1326"
              class="w-full h-auto object-contain group-hover:scale-[1.02] transition-transform duration-500"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <span class="text-[11px] text-neutral-400 mt-3 font-sans tracking-wide text-center">
            Edición Oficial · Volumen 01 (241 págs.)
          </span>
          <span class="inline-block mt-1 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-amber-500/10 border border-amber-500/30 text-amber-300 font-sans">
            📱 Edición digital · No incluye ejemplar físico
          </span>
        </div>

        <!-- Book Pitch & Details -->
        <div class="space-y-5 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-amber-500/15 text-amber-300 border border-amber-500/30 font-sans">
            <span>🔥 PRECIO ESPECIAL DE LANZAMIENTO · HASTA EL 31 DE OCTUBRE</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl font-black text-neutral-100 leading-tight">
            Acordes Ocultos <br />
            <span class="text-amber-400 font-normal italic text-2xl sm:text-3xl">Historias humanas detrás de la música</span>
          </h1>

          <p class="font-sans text-sm sm:text-base text-neutral-300 leading-relaxed max-w-2xl">
            Una selección curada de <strong>28 historias organizada en cuatro partes</strong>, con maquetación editorial reposada, fuentes, notas documentales completas y formatos (PDF interactivo de 241 páginas y EPUB) preparados para <strong>leer sin conexión a internet y sin distracciones</strong>.
          </p>

          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2 text-xs font-sans text-neutral-300 max-w-xl mx-auto lg:mx-0">
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> 28 crónicas íntegras
            </li>
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> 241 páginas maquetadas
            </li>
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> PDF interactivo + EPUB
            </li>
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> Enlaces a videos de Instagram
            </li>
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> Archivo y recreaciones
            </li>
            <li class="flex items-center gap-2 bg-[#171410] border border-[#2b261e] px-3 py-2 rounded-xl">
              <span class="text-amber-400 font-bold">✓</span> 100% Libre de DRM
            </li>
          </ul>

          <!-- Conexión explícita entre archivo web gratuito y edición del libro -->
          <div class="p-4 rounded-xl bg-[#14120f] border border-amber-500/30 text-xs sm:text-sm text-neutral-300 leading-relaxed font-sans">
            <p>
              <strong class="text-amber-300 font-semibold">¿Por qué comprarlo si leo gratis la web?</strong><br />
              El archivo web permanece gratuito. Este volumen reúne 28 de sus crónicas en una edición organizada en cuatro partes, ilustrada y preparada para conservar y leer sin conexión. Tu compra también ayuda a sostener nuevas investigaciones.
            </p>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a
              href={GUMROAD_BOOK_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-7 py-4 rounded-xl font-sans font-bold text-sm uppercase tracking-wider bg-gradient-to-r from-amber-500 to-amber-400 text-black hover:from-amber-400 hover:to-amber-300 transition-all transform hover:-translate-y-0.5 text-center flex items-center justify-center gap-2 shadow-xl shadow-amber-950/50"
            >
              <span>📖 Adquirir Libro ($7.99 USD) <span class="line-through text-black/60 font-normal text-xs ml-1">$9.99</span> →</span>
            </a>
            <a
              href="/book/Acordes_Ocultos_Volumen_I_Muestra.pdf"
              download="Acordes_Ocultos_Volumen_I_Muestra.pdf"
              class="w-full sm:w-auto px-5 py-4 rounded-xl font-sans font-bold text-xs uppercase tracking-wider bg-amber-500/15 text-amber-300 border border-amber-500/40 hover:bg-amber-500/25 transition-all text-center flex items-center justify-center gap-2"
            >
              <span>⬇️ Descargar Muestra (PDF · 3 Crónicas)</span>
            </a>
            <a
              href="#muestrario"
              class="w-full sm:w-auto px-4 py-4 rounded-xl font-sans font-semibold text-xs text-neutral-400 hover:text-amber-200 transition-colors text-center"
            >
              Ver diseño interior ↓
            </a>
          </div>

          <div class="space-y-1.5 text-[11px] text-neutral-400 font-sans">
            <p class="text-amber-300 font-semibold flex items-center gap-1.5 justify-center lg:justify-start">
              <span>📱</span> Edición digital de descarga inmediata. No incluye ejemplar físico.
            </p>
            <p>
              Recibes al instante el PDF Editorial de 241 páginas y el archivo EPUB 3 para Kindle, Apple Books, Kobo, tablet o móvil. Pagos procesados con seguridad vía Gumroad.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- ¿Qué es este libro? Descripción profunda de contenido -->
    <section class="space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-[0.25em] text-amber-400 font-bold font-sans">CONCEPTO EDITORIAL</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-neutral-100">
          La historia que la música no suele contar en los libros convencionales
        </h2>
        <p class="text-sm sm:text-base text-neutral-300 font-sans leading-relaxed">
          No encontrarás aquí una fría relación de fechas ni modelos de consolas. Este primer volumen reúne 28 microhistorias de alta tensión donde la música se presenta como testamento emocional, refugio espiritual y documento vivo del destino de las personas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans">
        <div class="p-6 rounded-2xl bg-[#14120f] border border-[#2b2721] space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-lg">
            ❤️
          </div>
          <h3 class="font-serif text-lg font-bold text-white">Primacía de la Emoción Humana</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Cada capítulo se enfoca en el drama íntimo de los creadores: la voz rota grabando entre lágrimas, el músico al borde de la quiebra que lo apuesta todo en una última toma o la despedida en la carretera.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#14120f] border border-[#2b2721] space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-lg">
            📜
          </div>
          <h3 class="font-serif text-lg font-bold text-white">Investigación Documental y Fuentes</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Prioridad al testimonio directo, registros de estudio y archivos de prensa frente al mito o la rumorología. Cada historia detalla sus fuentes documentales para que el lector pueda contrastar los hechos.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#14120f] border border-[#2b2721] space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-lg">
            🎬
          </div>
          <h3 class="font-serif text-lg font-bold text-white">Enlaces a los Videos de Cada Historia</h3>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Cada capítulo integra un enlace directo al Reel oficial de Instagram (@acordesocultos72) para acceder al video documental y escuchar la canción. <em>(Enlaces externos a Instagram; el libro no incrusta archivos locales de audio ni garantiza la permanencia técnica de enlaces de terceros).</em>
          </p>
        </div>
      </div>
    </section>

    <!-- Muestrario Visual de Páginas Reales / Screenshots -->
    <section id="muestrario" class="space-y-10 pt-4">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-amber-500/10 text-amber-300 border border-amber-500/30 font-sans">
          <span>📖 MUESTRARIO VISUAL DEL INTERIOR</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-neutral-100">
          Lo que recibirás al abrir el libro
        </h2>
        <p class="text-xs sm:text-sm text-neutral-400 font-sans leading-relaxed">
          Páginas reales capturadas directamente de la maqueta final del libro digital (241 páginas en PDF interactivo y EPUB).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PREVIEWS.map(item => (
          <div class="group rounded-2xl bg-[#13110e] border border-[#2b261e] hover:border-amber-500/50 transition-all duration-300 overflow-hidden flex flex-col shadow-xl">
            <!-- Page Snapshot -->
            <div class="relative aspect-[3/4] bg-[#0c0a08] overflow-hidden border-b border-[#242019] flex items-center justify-center p-3">
              <img
                src={item.image}
                alt={item.title}
                width="900"
                height="1350"
                class="w-full h-full object-contain rounded-lg shadow-2xl group-hover:scale-[1.03] transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute top-4 left-4 text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-md bg-black/85 text-amber-300 border border-amber-500/30 backdrop-blur font-sans">
                {item.tag}
              </span>
            </div>

            <!-- Page Feature Description -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3 font-sans">
              <div class="space-y-1.5">
                <h3 class="font-serif text-base font-bold text-white group-hover:text-amber-300 transition-colors">
                  {item.title}
                </h3>
                <p class="text-[11px] font-semibold text-amber-400/90 tracking-wide uppercase">
                  {item.subtitle}
                </p>
                <p class="text-xs text-neutral-400 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Ficha Técnica de la Edición Digital -->
    <section class="rounded-3xl bg-gradient-to-br from-[#171410] via-[#110f0d] to-[#0a0908] border border-amber-500/30 p-8 sm:p-12 space-y-8 shadow-2xl">
      <div class="text-center max-w-2xl mx-auto space-y-2">
