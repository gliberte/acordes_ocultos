---
import Layout from '../../../layouts/Layout.astro';
import InstagramEmbed from '../../../components/InstagramEmbed.astro';
import SpotifyEmbed from '../../../components/SpotifyEmbed.astro';
import StoryShare from '../../../components/StoryShare.astro';
import NewsletterBoxEn from '../../../components/NewsletterBoxEn.astro';
import { getAllStories, hasValidInstagramUrl, isPublishedEnglishStory } from '../../../lib/stories';
import { getCategoryLabelEn } from '../../../lib/categories';
import { formatChronicleMarkdown } from '../../../lib/markdown';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.get('preview') === 'true' && Astro.locals.isAdmin;
const allStories = await getAllStories({ includeHidden: true });

function formatViewsCount(views?: number): string {
  if (!views || views === 0) return '';
  if (views >= 1_000_000) return `${(views / 1_000_000).toFixed(1).replace('.0', '')}M`;
  if (views >= 10_000) return `${Math.round(views / 1_000)}K`;
  return views.toLocaleString();
}

// An extended English chronicle is strictly private and hidden until its official @secretchords72 Instagram Reel has been released.
// Non-negotiable rule: Only public display is allowed if it has an official English Instagram Reel and is not hidden in EN.
// Exception: Authenticated admin accessing in preview mode (?preview=true).
const story = allStories.find(s => {
  const matches = s.slug === slug || s.slugEn === slug || s.articleSlug === slug;
  if (!matches || !s.contentEn) return false;
  if (isPreview) return true;
  return isPublishedEnglishStory(s);
});

if (!story || !story.contentEn) {
  return Astro.redirect('/404');
}

// Related stories in English (must have an official @secretchords72 reel and not be hidden)
const relatedStories = allStories
  .filter(s => s.slug !== story.slug && isPublishedEnglishStory(s))
  .slice(0, 3);

const formattedContent = formatChronicleMarkdown(story.contentEn, story.articleSlug || story.slug);

Astro.response.headers.set('Cache-Control', isPreview ? 'private, no-store' : 'public, max-age=0, must-revalidate');

const siteUrl = 'https://www.acordesocultos.com';
const englishSlug = story.slugEn || story.slug;
const storyUrl = `${siteUrl}/en/stories/${englishSlug}`;
const spanishUrl = `${siteUrl}/historias/${story.slug}`;
const displayTitle = story.titleEn || story.title;
const displayHook = story.hookEn || story.hook;
const displayDescription = story.summaryEn || displayHook || displayTitle;
const categoryLabelEn = getCategoryLabelEn(story.category);
const coverImageEn = story.coverUrlEn || story.coverUrl;

const coverFull = coverImageEn?.startsWith('http') ? coverImageEn : `${siteUrl}${coverImageEn}`;
const heroFull = story.heroImageUrl?.startsWith('http') ? story.heroImageUrl : (story.heroImageUrl ? `${siteUrl}${story.heroImageUrl}` : undefined);
const images = [heroFull, coverFull].filter(Boolean);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      '@id': `${storyUrl}#article`,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        'name': 'Secret Chords',
        'url': `${siteUrl}/en`
      },
      'headline': displayTitle,
      'description': displayDescription,
      'inLanguage': 'en',
      'mainEntityOfPage': storyUrl,
      'url': storyUrl,
      'datePublished': story.publishedAt,
      'dateModified': story.publishedAt,
      'image': images,
      'articleSection': categoryLabelEn,
      'keywords': story.hashtags?.map((h: string) => h.replace(/^#/, '')) || [],
      'author': {
        '@type': 'Organization',
        'name': 'Secret Chords',
        'url': `${siteUrl}/en`
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Secret Chords',
        'url': `${siteUrl}/en`,
        'logo': {
          '@type': 'ImageObject',
          'url': `${siteUrl}/brand/secret-chords-logo-sm.webp`
        }
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${storyUrl}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${siteUrl}/en`
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Chronicles',
          'item': `${siteUrl}/en#stories`
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': displayTitle,
          'item': storyUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={`${displayTitle} | Secret Chords`}
  description={displayDescription}
  image={story.heroImageUrl || coverImageEn}
  type="article"
  publishedTime={story.publishedAt}
  author="Secret Chords"
  section={categoryLabelEn}
  tags={story.hashtags}
  jsonLd={articleSchema}
  lang="en"
  currentStory={story}
  alternateEs={spanishUrl}
  alternateEn={storyUrl}
>
  <article class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Breadcrumb & Top Bar -->
    <nav class="mb-8 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-400">
      <div class="flex items-center gap-2">
        <a href="/en" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/en#stories" class="hover:text-amber-400 transition-colors">Chronicles</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-[200px] sm:max-w-none">{displayTitle}</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-amber-500/10 text-amber-300 border border-amber-500/20">
          Secret Chords Archive
        </span>
      </div>
    </nav>

    <!-- 16:9 Editorial Widescreen Hero Banner (Secret Chords Masterpiece) -->
    <section class="relative w-full aspect-auto sm:aspect-[16/9] lg:aspect-[21/9] min-h-[480px] sm:min-h-[520px] lg:min-h-[580px] rounded-2xl overflow-hidden border border-[#2b2721] shadow-2xl shadow-black/90 mb-10 sm:mb-14 group">
      <!-- Background Stage Image -->
      <img
        src={story.heroImageUrl || coverImageEn}
        alt={displayTitle}
        width="1600"
        height="900"
        class="absolute inset-0 w-full h-full object-cover object-[center_20%] sm:object-center group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <!-- Cinematic Scrim Gradients -->
      <!-- Vertical: Open at the top on mobile so the artist shines through; deep at the bottom for readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0908] via-[#0a0908]/85 via-50% to-transparent sm:via-[#0a0908]/75 sm:to-black/20"></div>
      <!-- Horizontal: Side vignette for desktop layout -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/55 to-transparent hidden sm:block"></div>

      <!-- Content Overlay (Bottom-Left Rolling Stone Editorial Style) -->
      <div class="absolute inset-0 p-4 sm:p-10 lg:p-14 flex flex-col justify-end z-10">
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-2 sm:mb-4">
          <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-white text-black text-[10px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans">
            {categoryLabelEn}
          </span>
          {story.artist && (
            <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-black/70 backdrop-blur-md text-amber-400 border border-amber-500/30 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-sm font-sans">
              {story.artist}
            </span>
          )}
          <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-gradient-to-r from-amber-500 to-amber-600 text-black text-[10px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans flex items-center gap-1.5">
            <span>📖 Full Investigation</span>
          </span>
          {story.views && story.views >= 10_000 && (
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 bg-black/70 backdrop-blur-md text-neutral-300 border border-neutral-700 text-[10px] sm:text-xs font-mono rounded-sm flex items-center gap-1">
              <svg class="w-3 h-3 text-amber-400 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span>{formatViewsCount(story.views)} views</span>
            </span>
          )}
        </div>

        <!-- Headline (H1 for Document & SEO) -->
        <h1 class="font-serif text-xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight sm:leading-[1.08] mb-2 sm:mb-4 drop-shadow-md tracking-tight line-clamp-3 sm:line-clamp-none">
          {displayTitle}
        </h1>

        <!-- Hook Quote -->
        {displayHook && (
          <p class="font-serif italic text-xs sm:text-base md:text-lg text-amber-200/90 leading-snug sm:leading-relaxed mb-4 sm:mb-6 max-w-3xl border-l-2 border-amber-500 pl-3 sm:pl-4 line-clamp-2 sm:line-clamp-none">
            "{displayHook}"
          </p>
        )}

        <!-- Metadata & Action Buttons Row -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-white/10 text-xs text-neutral-300 font-sans">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-[11px] sm:text-xs text-neutral-400">
            <span>Secret Chords Archive</span>
            <span>•</span>
            <span>Read time: ~6 min</span>
            {story.songTitle && (
              <>
                <span>•</span>
                <span class="text-neutral-300">Track: <strong class="text-amber-400 font-semibold">"{story.songTitle}"</strong></span>
              </>
            )}
          </div>

          <!-- Mobile & Desktop Twin Action Buttons -->
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <a
              href="#chronicle"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-amber-500 hover:bg-amber-400 text-black font-bold text-xs sm:text-sm tracking-wide transition-all shadow-lg hover:shadow-amber-500/20 active:scale-95 cursor-pointer"
            >
              <span>Start Reading</span>
              <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>

            {hasValidInstagramUrl(story.instagramUrlEn) && (
              <a
                href={story.instagramUrlEn}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2 sm:px-4 sm:py-2.5 rounded-full bg-black/60 hover:bg-black/80 text-white font-medium text-xs sm:text-sm border border-white/20 hover:border-amber-400/50 transition-all backdrop-blur-md active:scale-95"
              >
                <svg class="w-3.5 h-3.5 fill-current text-amber-400" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3" />
                </svg>
                <span>Watch Video</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Main Grid: Video Player + The Chronicle -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Video Player & Audio Media (Sticky on large screens) -->
      <aside class="lg:col-span-5 space-y-6 sm:space-y-8 lg:sticky lg:top-28">
        
        <!-- Video / Documentary Player Card -->
        <div class="bg-[#12110e] rounded-2xl p-4 sm:p-6 border border-[#26231e] shadow-2xl">
          <InstagramEmbed
            reelUrl={story.instagramUrlEn}
            videoUrl={story.videoUrlEn}
            coverUrl={coverImageEn}
            title={displayTitle}
            artist={story.artist}
            lang="en"
          />

          <!-- Quick Actions / Social Share -->
          <div class="mt-4 pt-2">
            <StoryShare title={displayTitle} slug={`en/stories/${englishSlug}`} hook={displayHook} lang="en" />
          </div>
        </div>

        <!-- Official Spotify Embed Player -->
        <SpotifyEmbed
          spotifyUrl={story.spotifyUrl}
          artist={story.artist}
          songTitle={story.songTitle}
          lang="en"
        />

      </aside>

      <!-- Right Column: The Full Chronicle & Archival Content -->
      <section id="chronicle" class="lg:col-span-7 max-w-none">
        
        {isPreview && !isPublishedEnglishStory(story) && (
          <div class="mb-8 p-5 rounded-2xl border border-amber-500/50 bg-amber-950/30 text-amber-200 shadow-xl">
            <div class="flex items-center gap-2 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Administrator Preview Mode (@secretchords72)</span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-200 leading-relaxed font-sans">
              This English chronicle is <strong>strictly hidden from the public and search engines (returns 404)</strong> because{' '}
              {story.isHiddenEn
                ? 'it is manually hidden in the English Admin Panel (/admin/en).'
                : 'it does not yet have an officially published @secretchords72 Instagram Reel linked in /admin/en.'}
            </p>
          </div>
        )}

        <!-- Story Text / Chronicle -->
        <div class="prose prose-invert prose-amber max-w-none">
          <div set:html={formattedContent} />
        </div>

        <!-- English Newsletter Signup -->
        <NewsletterBoxEn source="web_en_story" />

        <!-- Back to Chronicles Button -->
        <div class="mt-12 pt-6 border-t border-[#26231e] flex items-center justify-between">
          <a
            href="/en#stories"
            class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300 font-sans transition-colors"
          >
            <span>← Back to all chronicles</span>
          </a>
        </div>

      </section>

    </div>

    <!-- Related English Chronicles -->
    {relatedStories.length > 0 && (
      <section class="mt-24 pt-12 border-t border-[#26231e]">
        <div class="mb-8">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-neutral-100">
            More Secret Chords Chronicles
          </h2>
          <p class="text-xs sm:text-sm text-neutral-400 mt-1 font-sans">
            Explore other untold stories from the golden era of rock and soul.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedStories.map((rel) => (
            <article class="rounded-xl overflow-hidden border border-[#26231e] bg-[#12100d] hover:border-amber-500/40 transition-all flex flex-col justify-between group">
              <a href={`/en/stories/${rel.slugEn || rel.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-black">
                <img
                  src={rel.coverUrlEn || rel.coverUrl}
                  alt={rel.titleEn || rel.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </a>
              <div class="p-5 flex flex-col justify-between flex-grow">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-widest text-amber-400 font-sans mb-1">
                    {rel.artist}
                  </p>
                  <h3 class="font-serif text-base font-bold text-white group-hover:text-amber-200 transition-colors line-clamp-2">
                    <a href={`/en/stories/${rel.slugEn || rel.slug}`}>
                      {rel.titleEn || rel.title}
                    </a>
                  </h3>
                  {(rel.hookEn || rel.hook) && (
                    <p class="text-xs text-neutral-400 font-sans mt-2 line-clamp-2 font-light">
                      {rel.hookEn || rel.hook}
                    </p>
                  )}
                </div>
                <div class="pt-4 mt-4 border-t border-[#1e1c18] flex items-center justify-between text-xs">
                  <a
                    href={`/en/stories/${rel.slugEn || rel.slug}`}
                    class="font-semibold text-amber-400 hover:text-amber-300 font-sans"
                  >
                    Read Chronicle →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

  </article>
</Layout>
