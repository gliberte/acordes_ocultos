---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Media Kit Oficial 2026 | Acordes Ocultos";
const pageDescription = "Presentación comercial, métricas oficiales de impacto y formatos de patrocinio para marcas y sellos discográficos en Acordes Ocultos.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 text-neutral-300">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold tracking-widest uppercase">
        <span>Press & Brand Partnerships</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight leading-tight">
        Acordes Ocultos <span class="text-amber-400 italic">Media Kit</span>
      </h1>
      <p class="text-neutral-400 text-base sm:text-lg font-serif italic max-w-2xl mx-auto">
        "Donde la historia de la música se cuenta con alma, tensión y rigor cinematográfico."
      </p>
    </div>

    <!-- Executive Summary / Manifiesto -->
    <div class="bg-[#12100d] border border-[#26221c] rounded-2xl p-6 sm:p-10 mb-16 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
      <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-3">Manifiesto & Propuesta de Valor</h2>
      <p class="text-lg text-neutral-200 leading-relaxed font-sans mb-6">
        <strong class="text-white">Acordes Ocultos</strong> es el medio digital de referencia en español consagrado a rescatar los enigmas, censuras, pérdidas y milagros sonoros que forjaron las grabaciones más icónicas de la historia.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-[#26221c] text-sm">
        <div class="space-y-1">
          <span class="text-amber-300 font-semibold block">Rigor Histórico Absoluto</span>
          <span class="text-neutral-400 text-xs">Cero especulaciones ni mitos falsos; cada dato respaldado por archivos hemerográficos y notas de producción.</span>
        </div>
        <div class="space-y-1">
          <span class="text-amber-300 font-semibold block">Estética Cinematográfica</span>
          <span class="text-neutral-400 text-xs">Producción vertical 9:16 con grano retro de película 35mm y cuidado orfebre del color y tipografía.</span>
        </div>
        <div class="space-y-1">
          <span class="text-amber-300 font-semibold block">Ecosistema Integrado</span>
          <span class="text-neutral-400 text-xs">Reels de impacto masivo, cortes ágiles para TikTok y crónicas profundas de archivo en nuestro portal web.</span>
        </div>
      </div>
    </div>

    <!-- Métricas Verificadas Grid -->
    <div class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400">Métricas de Impacto</h2>
          <p class="text-xl sm:text-2xl font-serif text-white font-bold">Datos Oficiales Consolidados</p>
        </div>
        <span class="text-xs px-3 py-1 rounded bg-[#1e1b16] border border-[#332e26] text-neutral-400">Septiembre 2026</span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-white block mb-1 font-serif">+22.800</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-1">Comunidad Total</span>
          <span class="text-[11px] text-neutral-500">+8.600 seguidores en los últimos 7 días</span>
        </div>

        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-amber-400 block mb-1 font-serif">1.54M+</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-300 block mb-1">Pico de Alcance</span>
          <span class="text-[11px] text-neutral-500">+1.005.000 cuentas únicas en 1 solo Reel</span>
        </div>

        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-white block mb-1 font-serif">30k – 90k</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-1">Suelo Garantizado</span>
          <span class="text-[11px] text-neutral-500">Rango promedio por producción estándar</span>
        </div>

        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-amber-300 block mb-1 font-serif">+16.500</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-300 block mb-1">Veces Compartido</span>
          <span class="text-[11px] text-neutral-500">Top 1% en ratio de difusión orgánica</span>
        </div>

        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-white block mb-1 font-serif">+97.200</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-1">Interacciones</span>
          <span class="text-[11px] text-neutral-500">Por producción destacada (Likes, Comentarios)</span>
        </div>

        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-5 sm:p-6 text-center">
          <span class="text-3xl sm:text-4xl font-bold text-white block mb-1 font-serif">+8.290</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-300 block mb-1">Guardados (Saves)</span>
          <span class="text-[11px] text-neutral-500">Alto valor como archivo de consulta</span>
        </div>
      </div>
    </div>

    <!-- Casos de Éxito / Rendimiento por Producción -->
    <div class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400">Casos de Éxito</h2>
          <p class="text-xl sm:text-2xl font-serif text-white font-bold">Rendimiento Comprobado por Producción</p>
        </div>
        <span class="text-xs px-3 py-1 rounded bg-[#1e1b16] border border-[#332e26] text-neutral-400">Instagram Insights</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Caso 1 -->
        <div class="bg-[#12100d] border border-amber-500/30 rounded-xl p-6 relative">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400">Mega Hit Viral</span>
            <span class="text-xs text-neutral-500">Sept 2026</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-white mb-1">Isabel Pantoja & Perales</h3>
          <p class="text-xs text-neutral-400 italic mb-4">«Marinero de Luces» — La verdad tras el luto</p>
          <div class="space-y-2.5 text-xs border-t border-[#221f1a] pt-4">
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Visualizaciones</span>
              <span class="text-amber-400 font-bold text-sm font-serif">1.543.000+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Cuentas Únicas (Alcance)</span>
              <span class="text-white font-semibold">1.005.500+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Veces Compartido (Shares)</span>
              <span class="text-amber-300 font-semibold">16.560+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Guardados (Saves)</span>
              <span class="text-white font-semibold">8.290+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Interacciones Totales</span>
              <span class="text-amber-400 font-bold">97.200+</span>
            </div>
          </div>
        </div>

        <!-- Caso 2 -->
        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Rock / Reggae Clásico</span>
            <span class="text-xs text-neutral-500">Sept 2026</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-white mb-1">Bob Marley</h3>
          <p class="text-xs text-neutral-400 italic mb-4">«Redemption Song» — El testamento acústico</p>
          <div class="space-y-2.5 text-xs border-t border-[#221f1a] pt-4">
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Visualizaciones</span>
              <span class="text-amber-400 font-bold text-sm font-serif">91.900+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Cuentas Únicas (Alcance)</span>
              <span class="text-white font-semibold">60.500+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Veces Compartido (Shares)</span>
              <span class="text-amber-300 font-semibold">1.660+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Guardados (Saves)</span>
              <span class="text-white font-semibold">770+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Interacciones Totales</span>
              <span class="text-amber-400 font-bold">10.600+</span>
            </div>
          </div>
        </div>

        <!-- Caso 3 -->
        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Balada Histórica</span>
            <span class="text-xs text-neutral-500">Sept 2026</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-white mb-1">Rocío Dúrcal & J. Gabriel</h3>
          <p class="text-xs text-neutral-400 italic mb-4">«Amor Eterno» — El dolor transatlántico</p>
          <div class="space-y-2.5 text-xs border-t border-[#221f1a] pt-4">
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Visualizaciones</span>
              <span class="text-amber-400 font-bold text-sm font-serif">74.600+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Cuentas Únicas (Alcance)</span>
              <span class="text-white font-semibold">53.900+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Veces Compartido (Shares)</span>
              <span class="text-amber-300 font-semibold">430+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Comentarios</span>
              <span class="text-white font-semibold">115+</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-neutral-400">Interacciones Totales</span>
              <span class="text-amber-400 font-bold">4.070+</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Demografía y Audiencia -->
    <div class="bg-[#12100d] border border-[#26221c] rounded-2xl p-6 sm:p-10 mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-2">Perfil de Audiencia</h2>
      <h3 class="text-xl sm:text-2xl font-serif text-white font-bold mb-6">Un público de alto valor cultural y poder adquisitivo</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
        <div>
          <span class="text-neutral-400 font-semibold uppercase tracking-wider text-xs block mb-3">Distribución por Edad</span>
          <ul class="space-y-2">
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>25 – 44 años (Núcleo)</span>
              <span class="text-amber-400 font-bold">52%</span>
            </li>
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>45 – 65+ años (Senior)</span>
              <span class="text-amber-400 font-bold">38%</span>
            </li>
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>18 – 24 años (Jóvenes)</span>
              <span class="text-neutral-500 font-bold">10%</span>
            </li>
          </ul>
        </div>

        <div>
          <span class="text-neutral-400 font-semibold uppercase tracking-wider text-xs block mb-3">Geografía Principal</span>
          <ul class="space-y-2">
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>España</span>
              <span class="text-white font-bold">45%</span>
            </li>
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>América Latina (MX, CO, AR)</span>
              <span class="text-white font-bold">38%</span>
            </li>
            <li class="flex justify-between items-center pb-1 border-b border-[#221f1a]">
              <span>Estados Unidos Hispano</span>
              <span class="text-white font-bold">17%</span>
            </li>
          </ul>
        </div>

        <div>
          <span class="text-neutral-400 font-semibold uppercase tracking-wider text-xs block mb-3">Intereses & Aficiones</span>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Nuestros seguidores son coleccionistas de discos en vinilo, usuarios de equipamiento de audio Hi-Fi (auriculares, tocadiscos, amplificadores), lectores asiduos de biografías musicales y asistentes regulares a festivales y conciertos.
          </p>
        </div>
      </div>
    </div>

    <!-- Formatos de Patrocinio y Tarifas -->
    <div class="mb-16">
      <div class="mb-8">
        <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400">Oportunidades Comerciales</h2>
        <p class="text-xl sm:text-2xl font-serif text-white font-bold">Formatos de Integración y Tarifas</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Formato 1 -->
        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-6 flex flex-col justify-between hover:border-amber-500/40 transition-colors">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-2">Formato 01</span>
            <h3 class="text-lg font-serif font-bold text-white mb-2">Mención Integrada en Reel & TikTok</h3>
            <p class="text-xs text-neutral-400 leading-relaxed mb-4">
              Integración sutil y de alta elegancia como presentador oficial del episodio en los primeros 5 segundos o en el cierre del video, con etiqueta de colaborador oficial y mención en copy.
            </p>
          </div>
          <div class="pt-4 border-t border-[#221f1a]">
            <span class="text-xs text-neutral-500 block">Tarifa estimada</span>
            <span class="text-2xl font-bold text-white font-serif">$450 – $750 <span class="text-xs font-sans text-neutral-400 font-normal">USD</span></span>
          </div>
        </div>

        <!-- Formato 2 -->
        <div class="bg-[#12100d] border border-amber-500/40 rounded-xl p-6 flex flex-col justify-between relative shadow-lg shadow-amber-500/5">
          <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-amber-500 text-[#0c0a08] text-[10px] font-bold uppercase tracking-wider">
            Más Popular
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-2">Formato 02</span>
            <h3 class="text-lg font-serif font-bold text-white mb-2">Microdocumental Temático a Medida</h3>
            <p class="text-xs text-neutral-400 leading-relaxed mb-4">
              Una historia completa investigada y producida en torno al territorio de la marca (lanzamiento de vinilo, historia de un amplificador o instrumento legendario, aniversario discográfico).
            </p>
          </div>
          <div class="pt-4 border-t border-[#221f1a]">
            <span class="text-xs text-neutral-500 block">Tarifa estimada</span>
            <span class="text-2xl font-bold text-amber-300 font-serif">$900 – $1.400 <span class="text-xs font-sans text-neutral-400 font-normal">USD</span></span>
          </div>
        </div>

        <!-- Formato 3 -->
        <div class="bg-[#12100d] border border-[#26221c] rounded-xl p-6 flex flex-col justify-between hover:border-amber-500/40 transition-colors">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 block mb-2">Formato 03</span>
            <h3 class="text-lg font-serif font-bold text-white mb-2">Campaña Multicanal Premium</h3>
            <p class="text-xs text-neutral-400 leading-relaxed mb-4">
              Máximo impacto y permanencia: Reel en Instagram + TikTok Cut + Crónica de archivo permanente en la web con banner y mención exclusiva de marca.
            </p>
          </div>
          <div class="pt-4 border-t border-[#221f1a]">
            <span class="text-xs text-neutral-500 block">Tarifa estimada</span>
            <span class="text-2xl font-bold text-white font-serif">$1.500 – $2.200 <span class="text-xs font-sans text-neutral-400 font-normal">USD</span></span>
          </div>
        </div>

      </div>
    </div>

    <!-- Marcas Objetivo / Target Fit -->
    <div class="bg-[#12100d] border border-[#26221c] rounded-2xl p-6 sm:p-8 mb-16 text-center">
      <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-3">Sectores Naturales de Colaboración</h3>
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs text-neutral-300 font-medium">
        <span class="px-3.5 py-1.5 rounded-lg bg-[#181512] border border-[#2b2720]">🎧 Auriculares y Audio Hi-Fi</span>
        <span class="px-3.5 py-1.5 rounded-lg bg-[#181512] border border-[#2b2720]">💿 Sellos Discográficos & Vinilos</span>
        <span class="px-3.5 py-1.5 rounded-lg bg-[#181512] border border-[#2b2720]">📚 Editoriales Literarias & Biografías</span>
        <span class="px-3.5 py-1.5 rounded-lg bg-[#181512] border border-[#2b2720]">📻 Giradiscos & Tocadiscos</span>
        <span class="px-3.5 py-1.5 rounded-lg bg-[#181512] border border-[#2b2720]">🎸 Instrumentos & Festivales</span>
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="text-center py-10 px-6 rounded-2xl bg-gradient-to-b from-[#181512] to-[#0c0a08] border border-amber-500/20 shadow-2xl">
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white mb-3">¿Deseas conectar tu marca con historias inolvidables?</h2>
      <p class="text-neutral-400 text-sm max-w-xl mx-auto mb-6">
        Diseñamos colaboraciones con la misma devoción y belleza con la que producimos cada una de nuestras crónicas. Hablemos hoy.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="mailto:luis.solano.l@gmail.com" 
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-[#0c0a08] font-bold text-sm tracking-wide transition-colors shadow-lg shadow-amber-500/20"
        >
          Solicitar Propuesta o Tarifa →
        </a>
        <a 
          href="https://www.instagram.com/acordesocultos72/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3 rounded-lg bg-[#1a1714] hover:bg-[#25211c] border border-[#332e26] text-neutral-300 font-semibold text-sm transition-colors"
        >
          Explorar Perfil de Instagram
        </a>
      </div>
      <p class="text-xs text-neutral-500 mt-4">
        Contacto directo: <span class="text-neutral-400">luis.solano.l@gmail.com</span>
      </p>
    </div>

  </div>
</Layout>
