---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import SubstackBanner from '../components/SubstackBanner.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import BrandBanner from '../components/BrandBanner.astro';
import { getAllStories } from '../lib/stories';
import { CATEGORIES } from '../lib/categories';

const allStories = await getAllStories();
const featuredStory = allStories[0] || null;
const latestReelStory = allStories.find(s => s.isLatestReel) || null;
const trendingStories = allStories.slice(1, 4);
const remainingStories = allStories.slice(1);

function formatViewsCount(views?: number): string {
  if (!views || views === 0) return '';
  if (views >= 1_000_000) return `${(views / 1_000_000).toFixed(1).replace('.0', '')}M`;
  if (views >= 10_000) return `${Math.round(views / 1_000)}K`;
  return views.toLocaleString();
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.acordesocultos.com/#website',
      'url': 'https://www.acordesocultos.com',
      'name': 'Acordes Ocultos',
      'description': 'Archivo de microhistorias de alta tensión, enigmas biográficos y el milagro sonoro detrás de las grabaciones más emblemáticas.',
      'inLanguage': 'es',
      'publisher': {
        '@id': 'https://www.acordesocultos.com/#organization'
      }
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.acordesocultos.com/#organization',
      'name': 'Acordes Ocultos',
      'url': 'https://www.acordesocultos.com',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://www.acordesocultos.com/brand/acordes-ocultos-logo-sm.webp',
        'caption': 'Acordes Ocultos'
      },
      'sameAs': [
        'https://instagram.com/acordesocultos',
        'https://tiktok.com/@acordesocultos',
        'https://acordesocultos.substack.com'
      ]
    }
  ]
};
---

<Layout 
  title="Acordes Ocultos | Archivo de Historias, Secretos y Leyendas de la Música"
  description="Explora las microhistorias de alta tensión, enigmas biográficos y el milagro sonoro detrás de las grabaciones más emblemáticas."
  image={featuredStory?.heroImageUrl || featuredStory?.coverUrl}
  jsonLd={websiteSchema}
>
  <!-- Brand Banner (Cabecera Principal Oficial) -->
  <BrandBanner />

  <!-- Hero Section: Portada Panorámica 16:9 Estilo Revista Rolling Stone -->
  {featuredStory && (
    <section class="relative pt-4 pb-0 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] overflow-hidden">
      <div class="max-w-7xl mx-auto">

        <!-- Top Live Badge Indicator -->
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-2.5 w-2.5 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
            </span>
            <span class="text-[11px] font-bold tracking-[0.2em] uppercase text-amber-400 font-sans flex items-center gap-2">
              <span>👑 Historia Más Vista del Archivo</span>
              {featuredStory.views && (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-black tracking-normal font-mono">
                  🔥 {featuredStory.views >= 1_000_000 ? `${(featuredStory.views / 1_000_000).toFixed(2)}M` : featuredStory.views.toLocaleString()} Reproducciones
                </span>
              )}
            </span>
          </div>

          {featuredStory.songTitle && (
            <span class="hidden sm:inline-block text-xs text-neutral-400 font-sans">
              Tema central: <strong class="text-amber-400">«{featuredStory.songTitle}»</strong>
            </span>
          )}
        </div>

        <!-- 16:9 Editorial Widescreen Hero Banner -->
        <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] lg:aspect-[21/9] min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-2xl overflow-hidden border border-[#2b2721] shadow-2xl shadow-black/90 group">
          <!-- Background Stage Image -->
          <img
            src={featuredStory.heroImageUrl || featuredStory.coverUrl}
            alt={featuredStory.title}
            width="1600"
            height="900"
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />

          <!-- Cinematic Scrim Gradients -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0908] via-[#0a0908]/75 via-black/30 to-black/20"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/50 to-transparent"></div>

          <!-- Content Overlay (Bottom-Left Rolling Stone Editorial Style) -->
          <div class="absolute inset-0 p-6 sm:p-10 lg:p-14 flex flex-col justify-end z-10">
            <!-- White Category Badge & Views (Rolling Stone style) -->
            <div class="flex flex-wrap items-center gap-2 mb-3 sm:mb-4">
              <span class="px-3 py-1 bg-white text-black text-[11px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans">
                {featuredStory.categoryLabel}
              </span>
              {featuredStory.artist && (
                <span class="px-3 py-1 bg-black/70 backdrop-blur-md text-amber-400 border border-amber-500/30 text-[11px] sm:text-xs font-bold uppercase tracking-wider rounded-sm font-sans">
                  {featuredStory.artist}
                </span>
              )}
              {featuredStory.views && (
                <span class="px-3 py-1 bg-gradient-to-r from-amber-500 to-amber-600 text-black text-[11px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.474.966-.567 1.343-.095.385-.125.703-.13.882a4.485 4.485 0 00-1.745-.333c-.704 0-1.37.172-1.96.478-.59.306-1.09.76-1.45 1.32-.36.56-.55 1.22-.55 1.94 0 1.23.51 2.37 1.34 3.19.83.82 1.97 1.33 3.2 1.33 1.23 0 2.37-.51 3.2-1.33.83-.82 1.34-1.96 1.34-3.19 0-.41-.06-.8-.17-1.17-.11-.37-.28-.7-.5-1-.22-.3-.49-.55-.8-.74a1 1 0 00-1.12 1.66c.15.1.28.23.39.38.11.15.19.32.25.5.06.18.09.38.09.58 0 .68-.28 1.3-.73 1.75-.45.45-1.07.73-1.75.73-.68 0-1.3-.28-1.75-.73-.45-.45-.73-1.07-.73-1.75 0-.41.11-.79.31-1.11.2-.32.49-.58.83-.75.34-.17.72-.26 1.13-.26.54 0 1.05.15 1.48.42.21.13.43.29.65.48.22.19.46.4.72.63a1 1 0 001.62-.78c0-.38-.05-.8-.15-1.25-.1-.45-.27-.95-.53-1.45-.26-.5-.61-.98-1.05-1.39z" clip-rule="evenodd" />
                  </svg>
                  <span>{formatViewsCount(featuredStory.views)} Vistas</span>
                </span>
              )}
            </div>

            <!-- Bold Editorial Headline -->
            <a href={`/historias/${featuredStory.slug}`} class="group/title block max-w-4xl">
              <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.08] tracking-tight group-hover/title:text-amber-300 transition-colors drop-shadow-md">
                {featuredStory.title}
              </h1>
            </a>

            <!-- Hook & Narrative Excerpt -->
            {featuredStory.hook && (
              <p class="font-serif italic text-sm sm:text-lg lg:text-xl text-neutral-200 leading-relaxed max-w-3xl mt-3 sm:mt-4 border-l-2 border-amber-500 pl-3 sm:pl-4 drop-shadow">
                «{featuredStory.hook}»
              </p>
            )}

            <!-- CTA Actions -->
            <div class="pt-5 sm:pt-6 flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href={`/historias/${featuredStory.slug}#cronica`}
                class="inline-flex items-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide bg-gradient-to-r from-amber-500 to-amber-600 text-black shadow-lg shadow-amber-950/60 hover:from-amber-400 hover:to-amber-500 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
              >
                <span>Leer Crónica Completa</span>
                <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={`/historias/${featuredStory.slug}`}
                class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-medium text-white bg-black/60 hover:bg-black/80 backdrop-blur-md border border-neutral-700 hover:border-amber-400 transition-all"
              >
                <svg class="w-4 h-4 fill-current text-amber-400" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Ver Video & Audio</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Editorial "Lo Más Destacado / Trending" Bar (Directly beneath the Hero) -->
        <div class="mt-6 mb-12 rounded-xl overflow-hidden border border-[#26221d] bg-[#12100e] shadow-lg">
          <!-- Crimson Header Bar -->
          <div class="bg-gradient-to-r from-[#b91c1c] to-[#991b1b] px-4 sm:px-6 py-2.5 flex items-center justify-between text-white">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.474.966-.567 1.343-.095.385-.125.703-.13.882a4.485 4.485 0 00-1.745-.333c-.704 0-1.37.172-1.96.478-.59.306-1.09.76-1.45 1.32-.36.56-.55 1.22-.55 1.94 0 1.23.51 2.37 1.34 3.19.83.82 1.97 1.33 3.2 1.33 1.23 0 2.37-.51 3.2-1.33.83-.82 1.34-1.96 1.34-3.19 0-.41-.06-.8-.17-1.17-.11-.37-.28-.7-.5-1-.22-.3-.49-.55-.8-.74a1 1 0 00-1.12 1.66c.15.1.28.23.39.38.11.15.19.32.25.5.06.18.09.38.09.58 0 .68-.28 1.3-.73 1.75-.45.45-1.07.73-1.75.73-.68 0-1.3-.28-1.75-.73-.45-.45-.73-1.07-.73-1.75 0-.41.11-.79.31-1.11.2-.32.49-.58.83-.75.34-.17.72-.26 1.13-.26.54 0 1.05.15 1.48.42.21.13.43.29.65.48.22.19.46.4.72.63a1 1 0 001.62-.78c0-.38-.05-.8-.15-1.25-.1-.45-.27-.95-.53-1.45-.26-.5-.61-.98-1.05-1.39z" clip-rule="evenodd" />
              </svg>
              <span class="font-serif font-black uppercase tracking-wider text-xs sm:text-sm">
                Lo Más Destacado
              </span>
            </div>
            <span class="text-[10px] sm:text-xs tracking-[0.2em] font-sans font-bold uppercase text-amber-200/90">
              Tendencias en la Comunidad
            </span>
          </div>

          <!-- 3 Highlight Stories Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#221e18]">
            {trendingStories.map((story, idx) => (
              <a
                href={`/historias/${story.slug}`}
                class="group p-4 sm:p-5 flex items-center gap-4 hover:bg-[#1a1714] transition-colors"
              >
                <div class="relative w-14 h-16 sm:w-16 sm:h-20 shrink-0 rounded-lg overflow-hidden border border-[#2b2721] group-hover:border-amber-500/50 transition-colors">
                  <img
                    src={story.coverUrl}
                    alt={story.title}
                    width="64"
                    height="80"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    onerror="this.src='/brand/acordes-ocultos-logo-sm.webp'"
                  />
                  <div class="absolute top-1 left-1 w-5 h-5 rounded-full bg-black/80 text-amber-400 font-bold text-[10px] flex items-center justify-center border border-amber-500/40 font-mono">
                    #{idx + 2}
                  </div>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      {story.categoryLabel}
                    </span>
                    <span class="text-xs font-semibold text-neutral-400 truncate">
                      {story.artist}
                    </span>
                  </div>
                  <h3 class="font-serif text-sm font-bold text-neutral-200 group-hover:text-amber-300 transition-colors line-clamp-2 leading-snug">
                    {story.title}
                  </h3>
                  {story.views && story.views > 0 && (
                    <div class="mt-1 flex items-center gap-1 text-[11px] font-mono text-amber-400/90">
                      <svg class="w-3 h-3 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      <span>{formatViewsCount(story.views)} vistas</span>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>
  )}

  <!-- Spotlight: Último Reel Estrenado en Instagram -->
  {latestReelStory && (
    <section class="py-12 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] bg-gradient-to-b from-[#0e0d0b] via-[#14120e] to-[#0a0908] relative overflow-hidden">
      <!-- Ambient Glow Behind Card -->
      <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <!-- Section Header Badge -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-400 text-black shadow-lg shadow-amber-500/30 font-sans">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Último Estreno en Instagram</span>
            </span>
            <span class="text-xs text-neutral-400 font-sans hidden sm:inline">
              Sintoniza el reel más reciente en la cuenta oficial <strong class="text-amber-300">@acordesocultos72</strong>
            </span>
          </div>

          {latestReelStory.instagramUrl && (
            <a
              href={latestReelStory.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors font-sans"
            >
              <span>Ver en Instagram</span>
              <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>

        <!-- Spotlight Card Container -->
        <div class="rounded-2xl overflow-hidden border border-amber-500/30 bg-[#12100e] shadow-2xl shadow-black/80 flex flex-col md:flex-row items-stretch">
          <!-- Thumbnail / Visual Cover (Left) -->
          <div class="relative w-full md:w-80 lg:w-96 shrink-0 aspect-[16/9] md:aspect-[9/12] overflow-hidden bg-neutral-950 group">
            <img
              src={latestReelStory.coverUrl}
              alt={latestReelStory.title}
              width="480"
              height="854"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/brand/acordes-ocultos-logo-sm.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 md:bg-gradient-to-r md:from-transparent md:to-[#12100e]"></div>

            <!-- Floating Reel Badge on image -->
            <div class="absolute top-3 left-3 z-10">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-black/80 backdrop-blur-md text-amber-300 border border-amber-500/40 font-sans">
                <svg class="w-3 h-3 text-amber-400 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Reel Oficial</span>
              </span>
            </div>

            <!-- Play Icon Center Overlay -->
            {latestReelStory.instagramUrl && (
              <a
                href={latestReelStory.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
                aria-label="Reproducir Reel en Instagram"
              >
                <div class="w-14 h-14 rounded-full bg-amber-500/90 text-black flex items-center justify-center shadow-xl shadow-amber-950/60 pl-1 group-hover:bg-amber-400">
                  <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </div>
              </a>
            )}
          </div>

          <!-- Editorial Details (Right) -->
          <div class="p-6 sm:p-8 lg:p-10 flex-1 flex flex-col justify-between">
            <div>
              <!-- Category & Artist Metadata -->
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  {latestReelStory.categoryLabel}
                </span>
                <span class="text-xs font-bold text-neutral-300">
                  {latestReelStory.artist}
                </span>
                {latestReelStory.songTitle && (
                  <>
                    <span class="text-neutral-600">•</span>
                    <span class="text-xs text-amber-400 font-semibold">
                      «{latestReelStory.songTitle}»
                    </span>
                  </>
                )}
                {latestReelStory.views && latestReelStory.views > 0 && (
                  <span class="ml-auto inline-flex items-center gap-1 text-[11px] font-mono text-amber-400/90 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                    <svg class="w-3 h-3 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>{formatViewsCount(latestReelStory.views)} vistas</span>
                  </span>
                )}
              </div>

              <!-- Title -->
              <a href={`/historias/${latestReelStory.slug}`} class="block group/link">
                <h3 class="font-serif text-xl sm:text-2xl lg:text-3xl font-black text-white leading-tight group-hover/link:text-amber-300 transition-colors">
                  {latestReelStory.title}
                </h3>
              </a>

              <!-- Hook / Narrative Synopsis -->
              {latestReelStory.hook && (
                <p class="font-serif italic text-sm sm:text-base text-neutral-300 leading-relaxed mt-3 border-l-2 border-amber-500/60 pl-3">
                  «{latestReelStory.hook}»
                </p>
              )}
            </div>

            <!-- Actions -->
            <div class="pt-6 mt-6 border-t border-[#23201a] flex flex-wrap items-center gap-3">
              {latestReelStory.instagramUrl && (
                <a
                  href={latestReelStory.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 text-black shadow-lg shadow-amber-950/60 hover:from-amber-400 hover:to-yellow-400 transition-all transform hover:-translate-y-0.5"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <span>Ver en Instagram</span>
                </a>
              )}

              <a
                href={`/historias/${latestReelStory.slug}`}
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-medium text-neutral-200 bg-[#1a1714] hover:bg-[#221f1a] border border-[#2b2721] hover:border-amber-500/50 transition-all"
              >
                <span>Leer Crónica Completa</span>
                <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Editorial Categories Bar -->
  <section id="categorias" class="py-12 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] bg-[#0c0b09]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="font-serif text-2xl font-bold text-neutral-100">Líneas Editoriales</h2>
        <p class="text-xs text-neutral-400 mt-1 font-sans">
          Cuatro perspectivas para desentrañar la historia viva de la música.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {Object.values(CATEGORIES).map(cat => (
          <div class="p-5 rounded-xl bg-[#14120f] border border-[#26231e] hover:border-amber-500/40 transition-colors flex flex-col justify-between">
            <div>
              <span class={`inline-block px-2.5 py-0.5 text-[10px] font-semibold tracking-wider uppercase rounded-full border mb-3 ${cat.badgeClass}`}>
                {cat.name}
              </span>
              <p class="text-xs text-neutral-400 leading-relaxed font-sans">
                {cat.description}
              </p>
            </div>
            <button 
              type="button" 
              onclick={`filterByCat('${cat.id}')`}
              class="mt-4 text-xs font-semibold text-amber-400 hover:text-amber-300 text-left"
            >
              Explorar relatos →
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories Catalog Section -->
  <section id="historias" class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header & Filter Pills -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <h2 class="font-serif text-3xl font-bold text-neutral-100">
            Archivo de Relatos
          </h2>
          <p class="text-xs text-neutral-400 mt-1">
            Total de historias documentadas en el catálogo: <strong class="text-amber-400">{allStories.length}</strong>
          </p>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center gap-2">
          <button 
            type="button" 
            onclick="filterByCat('all')" 
            id="pill-all"
            class="filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium border border-amber-500 bg-amber-500 text-black transition-all"
          >
            Todas ({allStories.length})
          </button>
          {Object.values(CATEGORIES).map(cat => {
            const count = allStories.filter(s => s.category === cat.id).length;
            return (
              <button 
                type="button" 
                onclick={`filterByCat('${cat.id}')`}
                id={`pill-${cat.id}`}
                class="filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium border border-[#2b2721] bg-[#14120f] text-neutral-300 hover:border-amber-500/50 transition-all"
              >
                {cat.name} ({count})
              </button>
            );
          })}
        </div>
      </div>

      <!-- Stories Grid -->
      <div id="stories-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {allStories.map(story => (
          <div class="story-item-wrapper" data-category={story.category}>
            <StoryCard story={story} />
          </div>
        ))}
      </div>

      <!-- Newsletter Box & Subscription Gateway -->
      <NewsletterBox source="homepage_catalog" />

    </div>
  </section>

  <!-- Instant Category Filter Script -->
  <script is:inline>
    function filterByCat(catId) {
      const wrappers = document.querySelectorAll('.story-item-wrapper');
      const pills = document.querySelectorAll('.filter-pill');

      // Update pills appearance
      pills.forEach(p => {
        p.classList.remove('bg-amber-500', 'text-black', 'border-amber-500');
        p.classList.add('bg-[#14120f]', 'text-neutral-300', 'border-[#2b2721]');
      });

      const activePill = document.getElementById(`pill-${catId}`);
      if (activePill) {
        activePill.classList.remove('bg-[#14120f]', 'text-neutral-300', 'border-[#2b2721]');
        activePill.classList.add('bg-amber-500', 'text-black', 'border-amber-500');
      }

      // Filter grid
      wrappers.forEach(wrap => {
        const itemCat = wrap.getAttribute('data-category');
        if (catId === 'all' || itemCat === catId) {
          wrap.style.display = '';
        } else {
          wrap.style.display = 'none';
        }
      });
    }

    // Check URL search param on load
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get('cat');
      if (cat) {
        filterByCat(cat);
      }
    });
  </script>
</Layout>
