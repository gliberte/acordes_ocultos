---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import SubstackBanner from '../components/SubstackBanner.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import BrandBanner from '../components/BrandBanner.astro';
import PromoStoriesCarousel from '../components/PromoStoriesCarousel.astro';
import { getAllStories } from '../lib/stories';
import { CATEGORIES } from '../lib/categories';

const allStories = await getAllStories();

// 1. Portada / Lead Story: Selección editorial independiente.
// Prioridad: Historia fijada editorialmente (isFeatured),
// o el estreno más reciente del archivo (isLatestReel),
// o la crónica de investigación más reciente (con artículo extendido),
// o la obra más reciente incorporada al catálogo.
const featuredStory = allStories.find(s => s.isFeatured)
  || allStories.find(s => s.isLatestReel)
  || allStories.find(s => Boolean(s.articleSlug) && Boolean(s.heroImageUrl || s.coverUrl))
  || allStories[0]
  || null;

// 2. Imprescindibles del Archivo: Obras consagradas con alto impacto documental y lectura histórica
const essentialStories = [...allStories]
  .filter(s => s.id !== featuredStory?.id)
  .sort((a, b) => {
    // Prioridad a piezas con crónica extendida completa
    const hasArticleA = a.articleSlug ? 1 : 0;
    const hasArticleB = b.articleSlug ? 1 : 0;
    if (hasArticleA !== hasArticleB) return hasArticleB - hasArticleA;
    return (b.views || 0) - (a.views || 0);
  })
  .slice(0, 3);

// 3. Novedad / Último Estreno Documental del Archivo
const latestStory = allStories.find(s => s.isLatestReel && s.id !== featuredStory?.id)
  || allStories.find(s => s.id !== featuredStory?.id && !essentialStories.some(e => e.id === s.id))
  || allStories[1]
  || null;

const remainingStories = allStories.filter(s => s.id !== featuredStory?.id);

function formatViewsCount(views?: number): string {
  if (!views || views === 0) return '';
  if (views >= 1_000_000) return `${(views / 1_000_000).toFixed(1).replace('.0', '')}M`;
  if (views >= 10_000) return `${Math.round(views / 1_000)}K`;
  return views.toLocaleString();
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.acordesocultos.com/#website',
      'url': 'https://www.acordesocultos.com',
      'name': 'Acordes Ocultos',
      'description': 'Archivo de microhistorias de alta tensión, enigmas biográficos y el milagro sonoro detrás de las grabaciones más emblemáticas.',
      'inLanguage': 'es',
      'publisher': {
        '@id': 'https://www.acordesocultos.com/#organization'
      }
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.acordesocultos.com/#organization',
      'name': 'Acordes Ocultos',
      'url': 'https://www.acordesocultos.com',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://www.acordesocultos.com/brand/acordes-ocultos-logo-sm.webp',
        'caption': 'Acordes Ocultos'
      },
      'sameAs': [
        'https://instagram.com/acordesocultos72',
        'https://tiktok.com/@acordesocultos',
        'https://acordesocultos.gumroad.com'
      ]
    }
  ]
};
---

<Layout 
  title="Acordes Ocultos | Archivo de Historias, Secretos y Leyendas de la Música"
  description="Explora las microhistorias de alta tensión, enigmas biográficos y el milagro sonoro detrás de las grabaciones más emblemáticas."
  image={featuredStory?.heroImageUrl || featuredStory?.coverUrl}
  jsonLd={websiteSchema}
>
  <!-- Brand Banner (Cabecera Principal Oficial) -->
  <BrandBanner />

  <!-- Hero Section: Portada Panorámica 16:9 Estilo Revista Rolling Stone -->
  {featuredStory && (
    <section class="relative pt-4 pb-0 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] overflow-hidden">
      <div class="max-w-7xl mx-auto">

        <!-- Top Editorial Badge Indicator -->
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-2.5 w-2.5 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
            </span>
            <span class="text-[11px] font-bold tracking-[0.2em] uppercase text-amber-400 font-sans flex items-center gap-2 flex-wrap">
              <span>✨ Gran Crónica de Portada</span>
              {featuredStory.articleSlug && (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px] font-bold tracking-normal font-sans">
                  📖 Investigación Completa
                </span>
              )}
              {featuredStory.views && featuredStory.views >= 50_000 && (
                <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-neutral-900/80 text-neutral-300 border border-neutral-700 text-[10px] font-mono">
                  🔥 {formatViewsCount(featuredStory.views)} visualizaciones en Instagram
                </span>
              )}
            </span>
          </div>

          {featuredStory.songTitle && (
            <span class="hidden sm:inline-block text-xs text-neutral-400 font-sans">
              Obra central: <strong class="text-amber-400">«{featuredStory.songTitle}»</strong>
            </span>
          )}
        </div>

        <!-- 16:9 Editorial Widescreen Hero Banner -->
        <div class="relative w-full aspect-auto sm:aspect-[16/9] lg:aspect-[21/9] min-h-[500px] sm:min-h-[520px] lg:min-h-[580px] rounded-2xl overflow-hidden border border-[#2b2721] shadow-2xl shadow-black/90 group">
          <!-- Background Stage Image -->
          <img
            src={featuredStory.heroImageUrl || featuredStory.coverUrl}
            alt={featuredStory.title}
            width="1600"
            height="900"
            class="absolute inset-0 w-full h-full object-cover object-[center_20%] sm:object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />

          <!-- Cinematic Scrim Gradients -->
          <!-- Vertical: Open at the top on mobile so the artist shines through; deep at the bottom for readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0908] via-[#0a0908]/85 via-50% to-transparent sm:via-[#0a0908]/75 sm:to-black/20"></div>
          <!-- Horizontal: Side vignette for desktop layout -->
          <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/55 to-transparent hidden sm:block"></div>

          <!-- Content Overlay (Bottom-Left Rolling Stone Editorial Style) -->
          <div class="absolute inset-0 p-4 sm:p-10 lg:p-14 flex flex-col justify-end z-10">
            <!-- Category Badge & Editorial Badges (Rolling Stone style) -->
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-2 sm:mb-4">
              <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-white text-black text-[10px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans">
                {featuredStory.categoryLabel}
              </span>
              {featuredStory.artist && (
                <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-black/70 backdrop-blur-md text-amber-400 border border-amber-500/30 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-sm font-sans">
                  {featuredStory.artist}
                </span>
              )}
              {featuredStory.articleSlug ? (
                <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-gradient-to-r from-amber-500 to-amber-600 text-black text-[10px] sm:text-xs font-black uppercase tracking-wider rounded-sm shadow-md font-sans flex items-center gap-1.5">
                  <span>📖 Crónica Extendida</span>
                </span>
              ) : (
                <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-sm font-sans flex items-center gap-1.5">
                  <span>⚡ Estreno Reciente</span>
                </span>
              )}
              {featuredStory.views && featuredStory.views >= 10_000 && (
                <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 bg-black/70 backdrop-blur-md text-neutral-300 border border-neutral-700 text-[10px] sm:text-xs font-mono rounded-sm flex items-center gap-1">
                  <svg class="w-3 h-3 text-amber-400 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <span>{formatViewsCount(featuredStory.views)}</span>
                </span>
              )}
            </div>

            <!-- Bold Editorial Headline -->
            <a href={`/historias/${featuredStory.slug}`} class="group/title block max-w-4xl">
              <h2 class="font-serif text-xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight sm:leading-[1.08] tracking-tight group-hover/title:text-amber-300 transition-colors drop-shadow-md line-clamp-3 sm:line-clamp-none">
                {featuredStory.title}
              </h2>
            </a>

            <!-- Hook & Narrative Excerpt -->
            {featuredStory.hook && (
              <p class="font-serif italic text-xs sm:text-base lg:text-xl text-neutral-200 leading-snug sm:leading-relaxed max-w-3xl mt-2 sm:mt-4 border-l-2 border-amber-500 pl-2.5 sm:pl-4 drop-shadow line-clamp-2 sm:line-clamp-none">
                «{featuredStory.hook}»
              </p>
            )}

            <!-- CTA Actions -->
            <div class="pt-3 sm:pt-6 flex flex-row items-center gap-2 sm:gap-4">
              <a
                href={`/historias/${featuredStory.slug}#cronica`}
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3.5 sm:px-6 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide bg-gradient-to-r from-amber-500 to-amber-600 text-black shadow-lg shadow-amber-950/60 hover:from-amber-400 hover:to-amber-500 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-center"
              >
                <span>Leer Crónica</span>
                <svg class="w-3.5 h-3.5 fill-none stroke-current shrink-0" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={`/historias/${featuredStory.slug}`}
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-5 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-medium text-white bg-black/60 hover:bg-black/80 backdrop-blur-md border border-neutral-700 hover:border-amber-400 transition-all text-center"
              >
                <svg class="w-3.5 h-3.5 fill-current text-amber-400 shrink-0" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Ver Video</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Editorial "Imprescindibles del Archivo" Bar (Directly beneath the Hero) -->
        <div class="mt-6 mb-12 rounded-xl overflow-hidden border border-[#26221d] bg-[#12100e] shadow-lg">
          <!-- Editorial Header Bar -->
          <div class="bg-gradient-to-r from-[#211a12] via-[#2d2216] to-[#1a140d] border-b border-amber-500/20 px-4 sm:px-6 py-2.5 flex items-center justify-between text-white">
            <div class="flex items-center gap-2">
              <span class="text-amber-400 font-bold text-sm">🏛️</span>
              <span class="font-serif font-bold uppercase tracking-wider text-xs sm:text-sm text-neutral-100">
                Imprescindibles del Archivo
              </span>
            </div>
            <span class="text-[10px] sm:text-xs tracking-[0.2em] font-sans font-bold uppercase text-amber-300/80">
              Obras Clave de Colección
            </span>
          </div>

          <!-- 3 Highlight Stories Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#221e18]">
            {essentialStories.map((story) => (
              <a
                href={`/historias/${story.slug}`}
                class="group p-4 sm:p-5 flex items-center gap-4 hover:bg-[#1a1714] transition-colors"
              >
                <div class="relative w-14 h-16 sm:w-16 sm:h-20 shrink-0 rounded-lg overflow-hidden border border-[#2b2721] group-hover:border-amber-500/50 transition-colors">
                  <img
                    src={story.coverUrl}
                    alt={story.title}
                    width="64"
                    height="80"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    onerror="this.src='/brand/acordes-ocultos-logo-sm.webp'"
                  />
                  {story.articleSlug && (
                    <div class="absolute top-1 left-1 px-1.5 py-0.5 rounded bg-amber-500/90 text-black font-bold text-[9px] uppercase font-sans tracking-tight">
                      Crónica
                    </div>
                  )}
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      {story.categoryLabel}
                    </span>
                    <span class="text-xs font-semibold text-neutral-400 truncate">
                      {story.artist}
                    </span>
                  </div>
                  <h3 class="font-serif text-sm font-bold text-neutral-200 group-hover:text-amber-300 transition-colors line-clamp-2 leading-snug">
                    {story.title}
                  </h3>
                  {story.views && story.views > 0 && (
                    <div class="mt-1 flex items-center gap-1 text-[11px] font-mono text-neutral-400 group-hover:text-amber-400/90 transition-colors">
                      <svg class="w-3 h-3 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      <span>{formatViewsCount(story.views)} visualizaciones en Instagram</span>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>
  )}

  <!-- Spotlight: Último Estreno Documental del Archivo -->
  {latestStory && (
    <section class="py-12 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] bg-gradient-to-b from-[#0e0d0b] via-[#14120e] to-[#0a0908] relative overflow-hidden">
      <!-- Ambient Glow Behind Card -->
      <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <!-- Section Header Badge -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-400 text-black shadow-lg shadow-amber-500/30 font-sans">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Último Estreno Documental</span>
            </span>
            <span class="text-xs text-neutral-400 font-sans hidden sm:inline">
              La entrega más reciente incorporada a nuestro archivo histórico sonoro
            </span>
          </div>

          {latestStory.instagramUrl && (
            <a
              href={latestStory.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors font-sans"
            >
              <span>Ver en Instagram</span>
              <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>

        <!-- Spotlight Card Container -->
        <div class="rounded-2xl overflow-hidden border border-amber-500/30 bg-[#12100e] shadow-2xl shadow-black/80 flex flex-col md:flex-row items-stretch">
          <!-- Thumbnail / Visual Cover (Left) -->
          <div class="relative w-full md:w-80 lg:w-96 shrink-0 aspect-[16/9] md:aspect-[9/12] overflow-hidden bg-neutral-950 group">
            <img
              src={latestStory.coverUrl}
              alt={latestStory.title}
              width="480"
              height="854"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/brand/acordes-ocultos-logo-sm.webp'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 md:bg-gradient-to-r md:from-transparent md:to-[#12100e]"></div>

            <!-- Floating Badge on image -->
            <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-black/80 backdrop-blur-md text-amber-300 border border-amber-500/40 font-sans">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span>Novedad</span>
              </span>
              {latestStory.articleSlug && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-amber-500/90 text-black font-sans">
                  📖 Crónica
                </span>
              )}
            </div>

            <!-- Link Overlay -->
            <a
              href={`/historias/${latestStory.slug}`}
              class="absolute inset-0 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
              aria-label="Leer historia"
            >
              <div class="w-14 h-14 rounded-full bg-amber-500/90 text-black flex items-center justify-center shadow-xl shadow-amber-950/60 pl-1 group-hover:bg-amber-400">
                <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
            </a>
          </div>

          <!-- Editorial Details (Right) -->
          <div class="p-6 sm:p-8 lg:p-10 flex-1 flex flex-col justify-between">
            <div>
              <!-- Category & Artist Metadata -->
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  {latestStory.categoryLabel}
                </span>
                <span class="text-xs font-bold text-neutral-300">
                  {latestStory.artist}
                </span>
                {latestStory.songTitle && (
                  <>
                    <span class="text-neutral-600">•</span>
                    <span class="text-xs text-amber-400 font-semibold">
                      «{latestStory.songTitle}»
                    </span>
                  </>
                )}
                {latestStory.views && latestStory.views > 0 && (
                  <span class="ml-auto inline-flex items-center gap-1 text-[11px] font-mono text-neutral-400 bg-neutral-900/80 px-2 py-0.5 rounded border border-neutral-700">
                    <svg class="w-3 h-3 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>{formatViewsCount(latestStory.views)} visualizaciones en Instagram</span>
                  </span>
                )}
              </div>

              <!-- Title -->
              <a href={`/historias/${latestStory.slug}`} class="block group/link">
                <h3 class="font-serif text-xl sm:text-2xl lg:text-3xl font-black text-white leading-tight group-hover/link:text-amber-300 transition-colors">
                  {latestStory.title}
                </h3>
              </a>

              <!-- Hook / Narrative Synopsis -->
              {latestStory.hook && (
                <p class="font-serif italic text-sm sm:text-base text-neutral-300 leading-relaxed mt-3 border-l-2 border-amber-500/60 pl-3">
                  «{latestStory.hook}»
                </p>
              )}
            </div>

            <!-- Actions -->
            <div class="pt-6 mt-6 border-t border-[#23201a] flex flex-wrap items-center gap-3">
              <a
                href={`/historias/${latestStory.slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 text-black shadow-lg shadow-amber-950/60 hover:from-amber-400 hover:to-yellow-400 transition-all transform hover:-translate-y-0.5"
              >
                <span>{latestStory.articleSlug ? 'Leer Crónica Completa' : 'Explorar Historia'}</span>
                <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              {latestStory.instagramUrl && (
                <a
                  href={latestStory.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-medium text-neutral-200 bg-[#1a1714] hover:bg-[#221f1a] border border-[#2b2721] hover:border-amber-500/50 transition-all"
                >
                  <svg class="w-4 h-4 fill-current text-amber-400" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <span>Ver en Instagram</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}


  <!-- Promo Stories Carousel: Carteleras y Avances Verticales 9:16 -->
  <PromoStoriesCarousel stories={allStories} />

  <!-- Editorial Categories Bar -->
  <section id="categorias" class="py-12 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] bg-[#0c0b09]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="font-serif text-2xl font-bold text-neutral-100">Líneas Editoriales</h2>
        <p class="text-xs text-neutral-400 mt-1 font-sans">
          Cinco perspectivas para desentrañar la historia viva de la música.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
        {Object.values(CATEGORIES).map(cat => (
          <div class="p-5 rounded-xl bg-[#14120f] border border-[#26231e] hover:border-amber-500/40 transition-colors flex flex-col justify-between">
            <div>
              <span class={`inline-block px-2.5 py-0.5 text-[10px] font-semibold tracking-wider uppercase rounded-full border mb-3 ${cat.badgeClass}`}>
                {cat.name}
              </span>
              <p class="text-xs text-neutral-400 leading-relaxed font-sans">
                {cat.description}
              </p>
            </div>
            <button 
              type="button" 
              onclick={`filterByCat('${cat.id}', true)`}
              class="mt-4 text-xs font-semibold text-amber-400 hover:text-amber-300 text-left cursor-pointer"
            >
              Explorar relatos →
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories Catalog Section -->
  <section id="historias" class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header & Filter / Sort Controls -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h2 class="font-serif text-3xl font-bold text-neutral-100">
              Archivo de Relatos
            </h2>
            <p class="text-xs text-neutral-400 mt-1">
              Total de historias documentadas en el catálogo: <strong class="text-amber-400">{allStories.length}</strong>
            </p>
          </div>

          <a 
            href="/en"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-[#181613] text-neutral-300 hover:text-amber-300 border border-[#2e2a24] hover:border-amber-500/50 transition-all font-sans self-start sm:self-auto"
            title="View English Edition (Secret Chords)"
          >
            <span>🇺🇸 English Edition (Secret Chords) →</span>
          </a>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <!-- Sort Mode Toggle (Recientes / Más Vistas) -->
          <div class="inline-flex items-center p-1 rounded-full bg-[#14120f] border border-[#2b2721] text-xs">
            <button
              type="button"
              onclick="setSortMode('recent')"
              id="sort-recent"
              class="sort-btn px-3 py-1 rounded-full font-bold transition-all text-black bg-amber-500 shadow-sm cursor-pointer"
            >
              ⏱️ Más Recientes
            </button>
            <button
              type="button"
              onclick="setSortMode('views')"
              id="sort-views"
              class="sort-btn px-3 py-1 rounded-full font-medium transition-all text-neutral-400 hover:text-white cursor-pointer"
            >
              🔥 Más Vistas
            </button>
          </div>

          <!-- Filter Pills -->
          <div class="flex flex-wrap items-center gap-2">
            <button 
              type="button" 
              onclick="filterByCat('all')" 
              id="pill-all"
              class="filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium border border-amber-500 bg-amber-500 text-black transition-all cursor-pointer"
            >
              Todas ({allStories.length})
            </button>
            {Object.values(CATEGORIES).map(cat => {
              const count = allStories.filter(s => s.category === cat.id).length;
              return (
                <button 
                  type="button" 
                  onclick={`filterByCat('${cat.id}')`}
                  id={`pill-${cat.id}`}
                  class="filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium border border-[#2b2721] bg-[#14120f] text-neutral-300 hover:border-amber-500/50 transition-all cursor-pointer"
                >
                  {cat.name} ({count})
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Stories Grid -->
      <div id="stories-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {allStories.map((story, index) => (
          <div 
            class="story-item-wrapper" 
            data-category={story.category}
            data-date={new Date(story.igPublishedAt || story.publishedAt || 0).getTime() || 0}
            data-views={typeof story.views === 'number' ? story.views : 0}
            style={index >= 24 ? "display: none;" : undefined}
          >
            <StoryCard story={story} />
          </div>
        ))}
      </div>

      <!-- Load More / Explorar más relatos Controller -->
      <div id="load-more-container" class="mt-12 mb-14 flex flex-col items-center justify-center gap-3.5">
        <button
          id="load-more-btn"
          type="button"
          onclick="loadMoreStories()"
          class="group inline-flex items-center gap-3 px-8 py-3.5 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-[#1c1914] via-[#161410] to-[#14120e] text-amber-300 border border-amber-500/40 hover:border-amber-400 hover:text-amber-200 hover:shadow-xl hover:shadow-amber-500/10 transition-all transform hover:-translate-y-0.5 active:translate-y-0 font-sans cursor-pointer"
        >
          <span>Explorar más relatos</span>
          <span id="load-more-count" class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-xs font-mono border border-amber-500/30 group-hover:bg-amber-500/30 transition-colors">
            ...
          </span>
          <svg class="w-4 h-4 text-amber-400 fill-none stroke-current transform group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <p id="stories-progress-text" class="text-xs text-neutral-400 font-sans text-center">
          Mostrando <strong id="current-shown" class="text-amber-400 font-mono">24</strong> de <strong id="total-available" class="text-neutral-200 font-mono">{allStories.length}</strong> relatos del archivo
        </p>
        <div id="stories-all-loaded" class="hidden items-center gap-2 px-5 py-2 rounded-full bg-[#161410] border border-amber-500/20 text-xs text-neutral-400 font-sans">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>Has recorrido todos los relatos de esta sección</span>
        </div>
      </div>

      <!-- Newsletter Box & Subscription Gateway -->
      <NewsletterBox source="homepage_catalog" />

    </div>
  </section>

  <!-- Instant Category Filter & Dynamic Pagination Script -->
  <script is:inline>
    const INITIAL_COUNT = 24;
    const BATCH_SIZE = 24;
    let currentCategory = 'all';
    let visibleCount = INITIAL_COUNT;

    function updateGridDisplay() {
      const wrappers = document.querySelectorAll('.story-item-wrapper');
      let matchingCount = 0;
      let shownCount = 0;

      wrappers.forEach(wrap => {
        const itemCat = wrap.getAttribute('data-category');
        const matchesCategory = (currentCategory === 'all' || itemCat === currentCategory);

        if (matchesCategory) {
          matchingCount++;
          if (matchingCount <= visibleCount) {
            wrap.style.display = '';
            shownCount++;
          } else {
            wrap.style.display = 'none';
          }
        } else {
          wrap.style.display = 'none';
        }
      });

      // Update counters and UI
      const currentShownEl = document.getElementById('current-shown');
      const totalAvailableEl = document.getElementById('total-available');
      const loadMoreBtn = document.getElementById('load-more-btn');
      const loadMoreCount = document.getElementById('load-more-count');
      const allLoadedEl = document.getElementById('stories-all-loaded');
      const progressText = document.getElementById('stories-progress-text');

      if (currentShownEl) currentShownEl.textContent = shownCount;
      if (totalAvailableEl) totalAvailableEl.textContent = matchingCount;

      const remaining = matchingCount - shownCount;

      if (remaining > 0) {
        if (loadMoreBtn) {
          loadMoreBtn.classList.remove('hidden');
          loadMoreBtn.style.display = 'inline-flex';
        }
        if (loadMoreCount) {
          loadMoreCount.textContent = `+${Math.min(remaining, BATCH_SIZE)} (${remaining} restantes)`;
        }
        if (allLoadedEl) {
          allLoadedEl.classList.add('hidden');
          allLoadedEl.classList.remove('flex');
        }
        if (progressText) progressText.classList.remove('hidden');
      } else {
        if (loadMoreBtn) {
          loadMoreBtn.classList.add('hidden');
          loadMoreBtn.style.display = 'none';
        }
        if (allLoadedEl) {
          allLoadedEl.classList.remove('hidden');
          allLoadedEl.classList.add('flex');
        }
      }
    }

    function loadMoreStories() {
      visibleCount += BATCH_SIZE;
      updateGridDisplay();
    }

    function filterByCat(catId, scroll = false) {
      currentCategory = catId;
      visibleCount = INITIAL_COUNT;

      const pills = document.querySelectorAll('.filter-pill');

      // Update pills appearance
      pills.forEach(p => {
        p.classList.remove('bg-amber-500', 'text-black', 'border-amber-500');
        p.classList.add('bg-[#14120f]', 'text-neutral-300', 'border-[#2b2721]');
      });

      const activePill = document.getElementById(`pill-${catId}`);
      if (activePill) {
        activePill.classList.remove('bg-[#14120f]', 'text-neutral-300', 'border-[#2b2721]');
        activePill.classList.add('bg-amber-500', 'text-black', 'border-amber-500');
      }

      updateGridDisplay();

      if (scroll) {
        const storiesEl = document.getElementById('historias');
        if (storiesEl) {
          storiesEl.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    let currentSort = 'recent';

    function setSortMode(mode) {
      if (currentSort === mode) return;
      currentSort = mode;

      const recentBtn = document.getElementById('sort-recent');
      const viewsBtn = document.getElementById('sort-views');

      if (mode === 'recent') {
        recentBtn?.classList.add('bg-amber-500', 'text-black', 'font-bold');
        recentBtn?.classList.remove('text-neutral-400', 'font-medium');
        viewsBtn?.classList.remove('bg-amber-500', 'text-black', 'font-bold');
        viewsBtn?.classList.add('text-neutral-400', 'font-medium');
      } else {
        viewsBtn?.classList.add('bg-amber-500', 'text-black', 'font-bold');
        viewsBtn?.classList.remove('text-neutral-400', 'font-medium');
        recentBtn?.classList.remove('bg-amber-500', 'text-black', 'font-bold');
        recentBtn?.classList.add('text-neutral-400', 'font-medium');
      }

      const grid = document.getElementById('stories-grid');
      if (!grid) return;

      const wrappers = Array.from(grid.querySelectorAll('.story-item-wrapper'));
      wrappers.sort((a, b) => {
        if (mode === 'recent') {
          const dateA = Number(a.getAttribute('data-date')) || 0;
          const dateB = Number(b.getAttribute('data-date')) || 0;
          return dateB - dateA;
        } else {
          const viewsA = Number(a.getAttribute('data-views')) || 0;
          const viewsB = Number(b.getAttribute('data-views')) || 0;
          return viewsB - viewsA;
        }
      });

      wrappers.forEach(w => grid.appendChild(w));
      visibleCount = INITIAL_COUNT;
      updateGridDisplay();
    }

    // Run immediately when script parses
    updateGridDisplay();

    // Check URL search param on load
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get('cat');
      if (cat) {
        filterByCat(cat);
      }
    });
  </script>
</Layout>
