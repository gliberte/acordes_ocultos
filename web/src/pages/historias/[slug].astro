---
import Layout from '../../layouts/Layout.astro';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import SubstackBanner from '../../components/SubstackBanner.astro';
import StoryCard from '../../components/StoryCard.astro';
import StoryReactions from '../../components/StoryReactions.astro';
import StoryShare from '../../components/StoryShare.astro';
import StoryComments from '../../components/StoryComments.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getAllStories } from '../../lib/stories';
import { formatChronicleMarkdown } from '../../lib/markdown';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.get('preview') === 'true' && Astro.locals.isAdmin;
const allStories = await getAllStories({ includeHidden: true });

function hasValidInstagramReel(s: any): boolean {
  const url = typeof s?.instagramUrl === 'string' ? s.instagramUrl.trim() : '';
  return url.length > 0 && (url.includes('instagram.com/reel/') || url.includes('instagram.com/p/'));
}

// Una crónica extendida es estrictamente privada y oculta hasta que su Reel de Instagram oficial haya sido estrenado.
// Regla innegociable: Solo se permite la visualización pública si cuenta con un Reel oficial de Instagram y no está oculta.
// Excepción: Administrador autenticado accediendo en modo vista previa (?preview=true).
const story = allStories.find(s => {
  const matchesSlug = s.slug === slug || s.articleSlug === slug;
  if (!matchesSlug) return false;
  if (isPreview) return true;
  return hasValidInstagramReel(s) && !s.isHidden;
});

if (!story) {
  return Astro.redirect('/404');
}

// Las historias relacionadas recomendadas deben pertenecer exclusivamente al archivo público estrenado con Reel
const relatedStories = allStories
  .filter(s => s.slug !== story.slug && hasValidInstagramReel(s) && !s.isHidden && (s.category === story.category || s.artist === story.artist))
  .slice(0, 3);

const formattedContent = formatChronicleMarkdown(story.content, story.articleSlug || story.slug);

Astro.response.headers.set('Cache-Control', isPreview ? 'private, no-store' : 'public, max-age=0, must-revalidate');

const siteUrl = 'https://www.acordesocultos.com';
const storyUrl = `${siteUrl}/historias/${story.slug}`;
const coverFull = story.coverUrl?.startsWith('http') ? story.coverUrl : `${siteUrl}${story.coverUrl}`;
const heroFull = story.heroImageUrl?.startsWith('http') ? story.heroImageUrl : (story.heroImageUrl ? `${siteUrl}${story.heroImageUrl}` : undefined);
const images = [heroFull, coverFull].filter(Boolean);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      '@id': `${storyUrl}#article`,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        'name': 'Acordes Ocultos',
        'url': siteUrl
      },
      'headline': story.title,
      'description': story.summary || story.hook || story.title,
      'inLanguage': 'es',
      'mainEntityOfPage': storyUrl,
      'url': storyUrl,
      'datePublished': story.publishedAt,
      'dateModified': story.publishedAt,
      'image': images,
      'articleSection': story.categoryLabel,
      'keywords': story.hashtags?.map((h: string) => h.replace(/^#/, '')) || [],
      'author': {
        '@type': 'Organization',
        'name': 'Acordes Ocultos',
        'url': siteUrl
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Acordes Ocultos',
        'url': siteUrl,
        'logo': {
          '@type': 'ImageObject',
          'url': `${siteUrl}/brand/acordes-ocultos-logo-sm.webp`
        }
      },
      ...(story.songTitle || story.artist ? {
        'about': {
          '@type': 'MusicRecording',
          'name': story.songTitle || story.title,
          ...(story.artist ? {
            'byArtist': {
              '@type': 'MusicGroup',
              'name': story.artist
            }
          } : {})
        }
      } : {})
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${storyUrl}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Inicio',
          'item': siteUrl
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Relatos',
          'item': `${siteUrl}/#historias`
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': story.title,
          'item': storyUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={`${story.title} | Acordes Ocultos`}
  description={story.summary || story.hook || story.title}
  image={story.heroImageUrl || story.coverUrl}
  type="article"
  publishedTime={story.publishedAt}
  section={story.categoryLabel}
  tags={story.hashtags}
  jsonLd={articleSchema}
>
  <article class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Breadcrumb & Top Bar -->
    <nav class="mb-8 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-400">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-amber-400 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/#historias" class="hover:text-amber-400 transition-colors">Relatos</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-[200px] sm:max-w-none">{story.title}</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-amber-500/10 text-amber-300 border border-amber-500/20">
          {story.categoryLabel}
        </span>
      </div>
    </nav>

    <!-- Header / Title block -->
    <header class="mb-12 max-w-4xl">
      {story.artist && (
        <p class="text-sm font-semibold tracking-widest uppercase text-amber-500 mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>{story.artist}</span>
          {story.songTitle && <span class="text-neutral-500">«{story.songTitle}»</span>}
        </p>
      )}

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-neutral-100 tracking-tight leading-[1.15] mb-6">
        {story.title}
      </h1>

      {story.hook && (
        <p class="font-serif italic text-xl sm:text-2xl text-amber-200/90 leading-relaxed border-l-2 border-amber-500 pl-5 my-6">
          "{story.hook}"
        </p>
      )}

      <div class="flex flex-wrap items-center gap-4 text-xs text-neutral-400 pt-2 border-t border-[#201e1a]">
        <span>Archivo Acordes Ocultos</span>
        <span>•</span>
        <span>Lectura estimada: ~4 min</span>
        {story.instagramUrl ? (
          <>
            <span>•</span>
            <span class="text-amber-400 font-medium">Reel oficial en Instagram</span>
          </>
        ) : (
          <>
            <span>•</span>
            <span class="text-amber-400 font-medium flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Video e Historia Próximamente</span>
            </span>
          </>
        )}
      </div>
    </header>

    <!-- Main Grid: Video Player + The Chronicle -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Video Player & Audio Media (Sticky on large screens) -->
      <aside class="lg:col-span-5 space-y-8 lg:sticky lg:top-28">
        
        <!-- Video / Instagram Reel Player Card -->
        <div class="bg-[#12110e] rounded-2xl p-4 sm:p-6 border border-[#26231e] shadow-2xl">
          <InstagramEmbed
            reelUrl={story.instagramUrl}
            videoUrl={story.videoUrl}
            tiktokVideoUrl={story.tiktokVideoUrl}
            coverUrl={story.coverUrl}
            title={story.title}
            artist={story.artist}
          />

          <!-- Quick Actions / Social Share -->
          <div class="mt-4 pt-2">
            <StoryShare title={story.title} slug={story.slug} hook={story.hook} />
          </div>
        </div>

        <!-- Official Spotify Embed Player -->
        <SpotifyEmbed
          spotifyUrl={story.spotifyUrl}
          artist={story.artist}
          songTitle={story.songTitle}
        />

        <!-- Cartel Oficial de la Historia / Póster Promocional -->
        {(story.promoPosterUrl || story.teaserUrl) && (
          <div class="rounded-2xl overflow-hidden border border-[#2b2721] bg-[#12100d] p-4 text-center shadow-2xl group transition-all hover:border-amber-500/40">
            <div class="flex items-center justify-between gap-2 mb-3 px-1">
              <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-widest font-black text-amber-400 font-sans">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                <span>Póster Oficial para Historias</span>
              </span>
              <span class="text-[9px] font-mono text-neutral-400 uppercase tracking-wider bg-[#1c1a16] px-2 py-0.5 rounded border border-[#2e2a24]">
                9:16 Vertical
              </span>
            </div>
            <div class="relative rounded-xl overflow-hidden bg-black/60 shadow-inner">
              <div class="absolute inset-0 z-10 pointer-events-none" data-image-shield="true" aria-hidden="true"></div>
              <img
                src={story.promoPosterUrl || story.teaserUrl}
                alt={`Póster oficial de ${story.title}`}
                draggable="false"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-cover rounded-xl select-none group-hover:scale-[1.02] transition-transform duration-500"
              />
            </div>
            <p class="text-[11px] text-neutral-400 font-sans italic mt-3 px-1">
              Diseño conmemorativo y cartel promocional emitido en nuestras historias oficiales.
            </p>
          </div>
        )}

      </aside>

      <!-- Right Column: The Full Chronicle & Story Scenes -->
      <section id="cronica" class="lg:col-span-7 max-w-none">
        
        {isPreview && !hasValidInstagramReel(story) && (
          <div class="mb-8 p-5 rounded-2xl border border-amber-500/50 bg-amber-950/30 text-amber-200 shadow-xl">
            <div class="flex items-center gap-2 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Modo Vista Previa de Administrador</span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-200 leading-relaxed font-sans">
              Esta crónica extendida está <strong>estrictamente oculta al público general y a buscadores (devuelve 404)</strong> porque aún no tiene un Reel de Instagram oficial asociado.
            </p>
          </div>
        )}

        <!-- Story Text / Chronicle -->
        <div class="prose prose-invert prose-amber max-w-none">
          <div set:html={formattedContent} />
        </div>

        <!-- Archival Photo Gallery (if extra images present) -->
        {story.extraImages && story.extraImages.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[#26231e]">
            <div class="mb-6">
              <h3 class="font-serif text-2xl font-bold text-neutral-100 flex items-center gap-3">
                <span>Archivo Fotográfico y Documental</span>
                <span class="text-xs font-sans font-normal px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/20">
                  {story.extraImages.length} fotos
                </span>
              </h3>
              <p class="text-xs text-neutral-400 mt-1 font-sans">
                Fotografías históricas, documentos y registros de época asociados a esta crónica.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {story.extraImages.map(img => (
                <figure class="rounded-xl overflow-hidden border border-[#26231e] bg-[#12100d] shadow-lg group select-none">
                  <div class="relative aspect-[4/3] bg-black/40 overflow-hidden">
                    <div class="absolute inset-0 z-10" data-image-shield="true" aria-hidden="true"></div>
                    <img
                      src={img.url}
                      alt={img.caption || story.title}
                      loading="lazy"
                      draggable="false"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 select-none pointer-events-none"
                    />
                  </div>
                  {(img.caption || img.credit) && (
                    <figcaption class="p-3 text-xs text-neutral-300 font-sans border-t border-[#1f1d19] space-y-1">
                      {img.caption && <p class="italic">{img.caption}</p>}
                      {img.credit && (
                        <p class="text-[10px] text-amber-500/80 uppercase font-mono tracking-wider">
                          Fuente: {img.credit}
                        </p>
                      )}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        )}

        <!-- Scene Breakdown (if scenes present) -->
        {story.scenes && story.scenes.length > 0 && (
          <div class="mt-16 pt-10 border-t border-[#26231e]">
            <h3 class="font-serif text-2xl font-bold text-neutral-100 mb-6 flex items-center gap-3">
              <span>Secuencia Narrativa del Reel</span>
              <span class="text-xs font-sans font-normal px-2.5 py-0.5 rounded-full bg-[#1c1a16] text-amber-400 border border-amber-500/30">
                {story.scenes.length} escenas
              </span>
            </h3>

            <div class="space-y-4">
              {story.scenes.map(sc => (
                <div class="p-4 rounded-xl bg-[#13120f] border border-[#221f1a] flex gap-4 items-start">
                  <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-300 font-mono text-xs flex items-center justify-center font-bold flex-shrink-0 border border-amber-500/30">
                    {sc.number}
                  </span>
                  <div class="space-y-1">
                    <p class="text-sm text-neutral-300 font-sans leading-relaxed">
                      {sc.text}
                    </p>
                    {sc.duration && (
                      <span class="text-[10px] text-neutral-400 font-mono">
                        Duración: {sc.duration}s
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Hashtags -->
        {story.hashtags && story.hashtags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[#201d19] flex flex-wrap gap-2">
            {story.hashtags.map(tag => (
              <span class="text-xs text-neutral-400 bg-[#161411] px-3 py-1 rounded-full border border-[#26231e]">
                {tag.startsWith('#') ? tag : `#${tag}`}
              </span>
            ))}
          </div>
        )}

        <!-- Story Reactions (Tocar Acorde de Honor / Me gusta) -->
        <StoryReactions slug={story.slug} initialLikes={story.social?.likes || 0} />

        <!-- Social Share Bar (Full Width Bottom) -->
        <StoryShare title={story.title} slug={story.slug} hook={story.hook} />

        <!-- Newsletter Subscription Box (Direct to Supabase + Substack) -->
        <NewsletterBox source={`story_${story.slug}`} />

        <!-- Community Reflections / Comments Section -->
        <StoryComments slug={story.slug} initialComments={story.social?.comments || []} />

      </section>

    </div>

    <!-- Related Stories Section -->
    {relatedStories.length > 0 && (
      <section class="mt-24 pt-12 border-t border-[#201e1a]">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-serif text-2xl font-bold text-neutral-100">
            Relatos Relacionados
          </h2>
          <a href="/#historias" class="text-xs font-semibold text-amber-400 hover:text-amber-300">
            Ver todas las historias →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedStories.map(rel => (
            <StoryCard story={rel} />
          ))}
        </div>
      </section>
    )}

  </article>
</Layout>
