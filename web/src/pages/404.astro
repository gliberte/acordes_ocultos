---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';
import { getAllStories } from '../lib/stories';

Astro.response.status = 404;

const allStories = await getAllStories();
// Selección de las 3 crónicas principales del archivo para mantener la lectura viva
const recommendedStories = allStories.slice(0, 3);

const pageTitle = '404: Acorde no encontrado | Acordes Ocultos';
const pageDescription = 'La historia o melodía que buscas no existe en este compás o ha cambiado de lugar en el archivo documental de Acordes Ocultos.';
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <main class="min-h-[75vh] flex flex-col justify-center">
    
    <!-- Hero Section 404 -->
    <div class="relative overflow-hidden py-16 sm:py-24 text-center">
      <!-- Ambient Glow de fondo -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-2xl mx-auto px-4 sm:px-6">
        <!-- Badge Editorial -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold tracking-widest uppercase mb-6 shadow-sm">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Error 404 // Silencio en la partitura</span>
        </div>

        <!-- 404 Display Tipográfico Vintage -->
        <div class="text-7xl sm:text-9xl font-serif font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-amber-200 via-amber-400 to-amber-700/60 leading-none select-none mb-4">
          404
        </div>

        <!-- Título Poético -->
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight leading-tight mb-4">
          Un acorde que se desvaneció en el tiempo
        </h1>

        <!-- Subtítulo / Explicación Editorial -->
        <p class="text-neutral-400 text-base sm:text-lg font-serif italic max-w-xl mx-auto mb-8 leading-relaxed">
          La historia o melodía que buscas no existe en este compás o fue reubicada en el archivo documental. Pero los grandes misterios de la música continúan.
        </p>

        <!-- Botones de Acción -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold text-sm transition-all duration-300 shadow-lg shadow-amber-500/20 hover:scale-[1.02] active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Volver a la portada</span>
          </a>
          
          <a
            href="/#cronicas"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#1a1714] hover:bg-[#25211c] text-neutral-200 hover:text-white border border-[#2e2922] font-semibold text-sm transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <span>Explorar el archivo</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Sección de Crónicas Recomendadas -->
    {recommendedStories.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 border-t border-[#26221c] pt-14 w-full">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
          <div>
            <div class="inline-flex items-center gap-2 text-amber-400/90 text-xs font-semibold tracking-wider uppercase mb-1">
              <span>Sugerencias del Archivo</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white tracking-tight">
              Crónicas que merecen ser escuchadas
            </h2>
          </div>
          <a
            href="/"
            class="text-xs sm:text-sm text-amber-400 hover:text-amber-300 font-medium inline-flex items-center gap-1 transition-colors group"
          >
            <span>Ver todas las crónicas</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recommendedStories.map((story) => (
            <StoryCard story={story} />
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>
