---
interface CommentItem {
  id: string;
  author: string;
  content: string;
  createdAt: string;
}

interface Props {
  slug: string;
  initialComments?: CommentItem[];
}

const { slug, initialComments = [] } = Astro.props;
---

<section id="comunidad" class="my-12 pt-8 border-t border-[#26221c]">
  <!-- Header Section -->
  <div class="flex items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
        </svg>
      </div>
      <div>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-white tracking-tight">
          Reflexiones de la Comunidad
        </h3>
        <p class="text-xs text-neutral-400 font-sans">
          ¿Viviste esa época o tienes una anécdota personal? Súmate al debate.
        </p>
      </div>
    </div>

    <span
      id={`comments-badge-${slug}`}
      class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#1c1915] text-amber-400 border border-amber-500/30"
    >
      {initialComments.length} {initialComments.length === 1 ? 'comentario' : 'comentarios'}
    </span>
  </div>

  <!-- New Comment Form -->
  <div class="p-6 rounded-2xl bg-[#14120f] border border-[#2b2721] mb-8 shadow-lg">
    <h4 class="text-xs font-bold uppercase tracking-wider text-amber-400 font-sans mb-4 flex items-center gap-2">
      <span>✍️ Deja tu testimonio o reflexión</span>
    </h4>

    <form id={`comment-form-${slug}`} class="space-y-4" data-slug={slug}>
      <div>
        <label for={`comment-author-${slug}`} class="block text-xs font-sans text-neutral-400 mb-1.5 font-medium">
          Tu Nombre o Alias
        </label>
        <input
          type="text"
          id={`comment-author-${slug}`}
          required
          maxlength="60"
          placeholder="Ej. Martín Santana o @rockero74"
          class="w-full px-4 py-2.5 rounded-xl bg-[#0a0908] border border-neutral-700 focus:border-amber-400 focus:outline-none text-white text-xs sm:text-sm placeholder:text-neutral-600 transition-colors"
        />
      </div>

      <div>
        <label for={`comment-content-${slug}`} class="block text-xs font-sans text-neutral-400 mb-1.5 font-medium">
          Tu Comentario o Recuerdo
        </label>
        <textarea
          id={`comment-content-${slug}`}
          required
          rows="3"
          maxlength="1500"
          placeholder="Comparte lo que te hace sentir esta historia, una versión favorita o un recuerdo..."
          class="w-full px-4 py-3 rounded-xl bg-[#0a0908] border border-neutral-700 focus:border-amber-400 focus:outline-none text-white text-xs sm:text-sm placeholder:text-neutral-600 transition-colors resize-y leading-relaxed"
        ></textarea>
      </div>

      <div class="flex items-start gap-2 pt-1">
        <input
          type="checkbox"
          id={`comment-consent-${slug}`}
          required
          class="mt-0.5 w-3.5 h-3.5 rounded border-neutral-700 bg-[#0a0908] text-amber-500 focus:ring-amber-400 focus:ring-offset-0 focus:outline-none cursor-pointer accent-amber-500 shrink-0"
        />
        <label for={`comment-consent-${slug}`} class="text-[11px] text-neutral-400 leading-snug cursor-pointer select-none">
          Acepto la <a href="/privacidad" target="_blank" class="text-amber-400 underline hover:text-amber-300">Política de Privacidad</a> y confirmo que tengo <strong>14 años o más</strong>.
        </label>
      </div>

      <div class="flex items-center justify-between pt-1">
        <p class="text-[11px] text-neutral-500 font-sans">
          Respeto mutuo y devoción por la música.
        </p>

        <button
          type="submit"
          id={`comment-submit-btn-${slug}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wide bg-gradient-to-r from-amber-500 to-amber-600 text-black hover:from-amber-400 hover:to-amber-500 transition-all shadow-md shadow-amber-950/40 cursor-pointer disabled:opacity-50"
        >
          <span>Publicar Comentario</span>
          <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </div>
    </form>

    <div id={`comment-feedback-${slug}`} class="hidden mt-3 p-3 rounded-xl text-xs font-sans"></div>
  </div>

  <!-- Comments List Container -->
  <div id={`comments-list-${slug}`} class="space-y-4">
    {initialComments.length === 0 ? (
      <div id={`comments-empty-${slug}`} class="text-center py-10 px-4 rounded-2xl bg-[#0e0d0b] border border-dashed border-[#2b2721]">
        <span class="text-3xl block mb-2 opacity-60">🎸</span>
        <p class="text-sm font-serif italic text-neutral-300 mb-1">
          Aún no hay testimonios en esta crónica.
        </p>
        <p class="text-xs text-neutral-400 font-sans">
          Sé el primero en compartir tu recuerdo o apreciación sobre este clásico.
        </p>
      </div>
    ) : (
      initialComments.map((comment) => (
        <div class="p-5 rounded-2xl bg-[#110f0d] border border-[#24201a] hover:border-[#383228] transition-colors">
          <div class="flex items-center justify-between gap-3 mb-2.5">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 text-black font-bold font-sans text-xs flex items-center justify-center uppercase shadow-sm">
                {comment.author.charAt(0)}
              </div>
              <span class="font-sans font-bold text-xs sm:text-sm text-neutral-200">
                {comment.author}
              </span>
            </div>

            <time class="text-[10px] sm:text-xs text-neutral-400 font-sans font-medium">
              {new Date(comment.createdAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
          </div>

          <p class="text-xs sm:text-sm text-neutral-300 font-serif leading-relaxed whitespace-pre-line pl-9">
            {comment.content}
          </p>
        </div>
      ))
    )}
  </div>
</section>

<script define:vars={{ slug }}>
  (function() {
    const form = document.getElementById(`comment-form-${slug}`);
    const authorInput = document.getElementById(`comment-author-${slug}`);
    const contentInput = document.getElementById(`comment-content-${slug}`);
    const consentInput = document.getElementById(`comment-consent-${slug}`);
    const submitBtn = document.getElementById(`comment-submit-btn-${slug}`);
    const feedback = document.getElementById(`comment-feedback-${slug}`);
    const list = document.getElementById(`comments-list-${slug}`);
    const badge = document.getElementById(`comments-badge-${slug}`);
    const emptyNotice = document.getElementById(`comments-empty-${slug}`);

    function renderComment(c) {
      const card = document.createElement('div');
      card.className = 'p-5 rounded-2xl bg-[#110f0d] border border-amber-500/40 transition-colors animate-fade-in';
      const initial = (c.author || 'M').charAt(0).toUpperCase();
      const dateStr = new Date(c.createdAt || Date.now()).toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });

      card.innerHTML = `
        <div class="flex items-center justify-between gap-3 mb-2.5">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 text-black font-bold font-sans text-xs flex items-center justify-center uppercase shadow-sm">
              ${initial}
            </div>
            <span class="font-sans font-bold text-xs sm:text-sm text-neutral-200">
              ${c.author}
            </span>
          </div>
          <time class="text-[10px] sm:text-xs text-neutral-400 font-sans font-medium">
            ${dateStr}
          </time>
        </div>
        <p class="text-xs sm:text-sm text-neutral-300 font-serif leading-relaxed whitespace-pre-line pl-9">
          ${c.content}
        </p>
      `;
      return card;
    }

    // Refresh comments on load
    fetch(`/api/comments?slug=${encodeURIComponent(slug)}`)
      .then(r => r.json())
      .then(data => {
        if (data && Array.isArray(data.comments) && data.comments.length > 0) {
          if (badge) {
            badge.textContent = `${data.comments.length} ${data.comments.length === 1 ? 'comentario' : 'comentarios'}`;
          }
          if (list) {
            list.innerHTML = '';
            data.comments.forEach(c => list.appendChild(renderComment(c)));
          }
        }
      })
      .catch(() => {});

    // Submit handler
    if (form && authorInput && contentInput && consentInput && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const author = authorInput.value.trim();
        const content = contentInput.value.trim();

        if (!author || !content) return;
        if (!consentInput.checked) {
          alert('Debes aceptar la política de privacidad y confirmar que eres mayor de 14 años.');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Publicando...</span>';

        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, author, content })
          });

          const data = await res.json();

          if (res.ok && data.success && data.comment) {
            // Remove empty notice if present
            const empty = document.getElementById(`comments-empty-${slug}`);
            if (empty) empty.remove();

            // Prepend new comment
            if (list) {
              list.prepend(renderComment(data.comment));
            }

            // Update badge count
            if (badge) {
              const currentNum = parseInt(badge.textContent || '0') || 0;
              const newNum = currentNum + 1;
              badge.textContent = `${newNum} ${newNum === 1 ? 'comentario' : 'comentarios'}`;
            }

            // Reset form
            contentInput.value = '';
            if (feedback) {
              feedback.className = 'mt-3 p-3 rounded-xl text-xs font-sans bg-emerald-950/80 border border-emerald-500/40 text-emerald-200';
              feedback.textContent = '¡Tu comentario ha sido publicado en el archivo!';
              feedback.classList.remove('hidden');
              setTimeout(() => { feedback.classList.add('hidden'); }, 4000);
            }
          } else {
            if (feedback) {
              feedback.className = 'mt-3 p-3 rounded-xl text-xs font-sans bg-red-950/80 border border-red-500/40 text-red-200';
              feedback.textContent = data.error || 'Ocurrió un error al enviar el comentario.';
              feedback.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (feedback) {
            feedback.className = 'mt-3 p-3 rounded-xl text-xs font-sans bg-red-950/80 border border-red-500/40 text-red-200';
            feedback.textContent = 'Error de conexión. Intenta de nuevo.';
            feedback.classList.remove('hidden');
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            <span>Publicar Comentario</span>
            <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          `;
        }
      });
    }
  })();
</script>
