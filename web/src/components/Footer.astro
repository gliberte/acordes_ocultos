---
import { useTranslations, getLocale } from '../i18n/ui';

interface Props {
  lang?: 'es' | 'en';
}

const { lang: propLang } = Astro.props;
const locale = propLang || getLocale(Astro.currentLocale || Astro.url.pathname);
const isEn = locale === 'en';
const t = useTranslations(locale);
---

<footer class="bg-[#080706] border-t border-[#22201c] text-neutral-400 text-sm mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/brand/acordes-ocultos-logo-sm.webp" 
            alt={t('brand', 'name')} 
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="w-10 h-10 rounded-full border border-amber-500/40" 
          />
          <span class="font-serif text-lg tracking-wider text-amber-400 font-bold">
            {t('brand', 'name')}
          </span>
        </div>
        <p class="text-neutral-400 text-xs leading-relaxed font-sans">
          {t('brand', 'description')}
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
          <a href="https://instagram.com/acordesocultos72" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-400 transition-colors">
            Instagram
          </a>
          <span class="text-neutral-700">•</span>
          <a href="https://tiktok.com/@acordesocultos" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-400 transition-colors">
            TikTok
          </a>
          <span class="text-neutral-700">•</span>
          <a href="/libro" class="text-amber-400 hover:text-amber-300 transition-colors font-medium">
            {isEn ? '📘 Anthology Book' : '📘 Libro (Volumen 01)'}
          </a>
          <span class="text-neutral-700">•</span>
          <a href="https://acordesocultos.gumroad.com/l/ryhupd" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-300 transition-colors">
            {isEn ? '☕ Support' : '☕ Apoyar'}
          </a>
        </div>
      </div>

      <!-- Column 2: Categorías -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">
          {t('footer', 'categories')}
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href={isEn ? "/en#series" : "/?cat=acordes-ocultos#historias"} class="hover:text-amber-400 transition-colors">Acordes Ocultos</a></li>
          <li><a href={isEn ? "/en#series" : "/?cat=historia-en-los-acordes#historias"} class="hover:text-amber-400 transition-colors">Historia en los Acordes</a></li>
          <li><a href={isEn ? "/en#series" : "/?cat=destellos-de-gloria#historias"} class="hover:text-amber-400 transition-colors">Destellos de Gloria</a></li>
          <li><a href={isEn ? "/en#series" : "/?cat=catedrales-de-leyenda#historias"} class="hover:text-amber-400 transition-colors">Catedrales de Leyenda</a></li>
          <li><a href={isEn ? "/en#series" : "/?cat=forjados-en-el-barro#historias"} class="hover:text-amber-400 transition-colors">Forjados en el Barro</a></li>
        </ul>
      </div>

      <!-- Column 3: Libro, Mecenazgo & Boletín -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">
          {t('footer', 'community')}
        </h4>
        <p class="text-xs text-neutral-400 leading-relaxed mb-4">
          {isEn
            ? "Discover our Anthology Book (Vol. 01), support independent music journalism as a patron, or subscribe to our free weekly chronicle."
            : "Descubre los detalles del Libro Recopilatorio (Vol. 01), apoya la investigación como mecenas o únete a la Cofradía para recibir crónicas semanales gratis."}
        </p>
        <div class="flex flex-wrap gap-2">
          <a 
            href="/libro"
            class="inline-block px-3.5 py-2 text-xs font-semibold rounded bg-[#1c1a16] border border-amber-500/30 text-amber-300 hover:bg-amber-500/10 transition-colors"
          >
            {isEn ? "📘 View Book (Vol. 01) →" : "📘 Ver Libro (Vol. 01) →"}
          </a>
          <a 
            href="https://acordesocultos.gumroad.com/l/ryhupd" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-block px-3.5 py-2 text-xs font-semibold rounded bg-[#1c1a16] border border-amber-500/30 text-amber-300 hover:bg-amber-500/10 transition-colors"
          >
            {isEn ? "☕ Tip / Support ($3+) →" : "☕ Apoyar ($3+) →"}
          </a>
        </div>
      </div>

      <!-- Column 4: Legal y Privacidad -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">
          {t('footer', 'legal')}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/privacidad" class="hover:text-amber-400 transition-colors">
              {t('footer', 'privacy')}
            </a>
          </li>
          <li>
            <a href="/aviso-legal" class="hover:text-amber-400 transition-colors">
              {t('footer', 'terms')}
            </a>
          </li>
          <li>
            <a href="/cookies" class="hover:text-amber-400 transition-colors">
              {t('footer', 'cookies')}
            </a>
          </li>
          <li>
            <a href="/privacidad#menores" class="text-neutral-400 hover:text-amber-400 transition-colors flex items-center gap-1.5">
              <span>{isEn ? "Child Safety Protection (+14)" : "Protección de Menores (+14)"}</span>
            </a>
          </li>
          <li class="pt-1">
            <button
              type="button"
              id="footer-reopen-cookies"
              class="text-neutral-400 hover:text-amber-400 transition-colors cursor-pointer text-left text-[11px] underline"
            >
              {isEn ? "⚙️ Cookie Preferences" : "⚙️ Preferencias de Cookies"}
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[#181613] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-400 font-sans">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <p>© {new Date().getFullYear()} {t('brand', 'name')}. {t('footer', 'rights')}</p>
        <span class="hidden sm:inline text-neutral-700">•</span>
        <div class="flex items-center gap-3 text-[11px] text-neutral-400">
          <a href="/privacidad" class="hover:underline">{isEn ? 'Privacy' : 'Privacidad'}</a>
          <span>·</span>
          <a href="/aviso-legal" class="hover:underline">{isEn ? 'Terms' : 'Aviso Legal'}</a>
          <span>·</span>
          <a href="/cookies" class="hover:underline">Cookies</a>
        </div>
      </div>
      <p class="italic font-serif text-neutral-400 text-center md:text-right">
        {isEn ? '"Behind every perfect chord hides a wound or a miracle."' : '"Detrás de cada acorde perfecto se oculta una herida o un milagro."'}
      </p>
    </div>
  </div>
</footer>

<script>
  (function() {
    const btn = document.getElementById('footer-reopen-cookies');
    if (btn) {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('acordes_reopen_cookie_banner'));
      });
    }
  })();
</script>
