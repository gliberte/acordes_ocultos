---
---
<footer class="bg-[#080706] border-t border-[#22201c] text-neutral-400 text-sm mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/brand/acordes-ocultos-logo-sm.webp" 
            alt="Acordes Ocultos" 
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="w-10 h-10 rounded-full border border-amber-500/40" 
          />
          <span class="font-serif text-lg tracking-wider text-amber-400 font-bold">ACORDES OCULTOS</span>
        </div>
        <p class="text-neutral-400 text-xs leading-relaxed font-sans">
          Crónicas de archivo, microhistorias de alta tensión y secretos desenterrados de las canciones que definieron generaciones.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
          <a href="https://instagram.com/acordesocultos72" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-400 transition-colors">
            Instagram
          </a>
          <span class="text-neutral-700">•</span>
          <a href="https://tiktok.com/@acordesocultos" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-400 transition-colors">
            TikTok
          </a>
          <span class="text-neutral-700">•</span>
          <a href="https://acordesocultos.substack.com" target="_blank" rel="noopener" class="text-neutral-400 hover:text-amber-400 transition-colors">
            Substack
          </a>
        </div>
      </div>

      <!-- Column 2: Categorías -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">Líneas Editoriales</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/?cat=acordes-ocultos#historias" class="hover:text-amber-400 transition-colors">Acordes Ocultos</a></li>
          <li><a href="/?cat=historia-en-los-acordes#historias" class="hover:text-amber-400 transition-colors">Historia en los Acordes</a></li>
          <li><a href="/?cat=destellos-de-gloria#historias" class="hover:text-amber-400 transition-colors">Destellos de Gloria</a></li>
          <li><a href="/?cat=catedrales-de-leyenda#historias" class="hover:text-amber-400 transition-colors">Catedrales de Leyenda</a></li>
        </ul>
      </div>

      <!-- Column 3: Boletín -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">La Crónica Semanal</h4>
        <p class="text-xs text-neutral-400 leading-relaxed mb-4">
          Recibe cada semana una historia completa en tu correo, con fotografías inéditas y análisis musical en profundidad.
        </p>
        <a 
          href="https://acordesocultos.substack.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block px-4 py-2 text-xs font-semibold rounded bg-[#1c1a16] border border-amber-500/30 text-amber-300 hover:bg-amber-500/10 transition-colors"
        >
          Ir a Substack →
        </a>
      </div>

      <!-- Column 4: Legal y Privacidad -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4">Legal & Privacidad</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/privacidad" class="hover:text-amber-400 transition-colors">
              Política de Privacidad
            </a>
          </li>
          <li>
            <a href="/aviso-legal" class="hover:text-amber-400 transition-colors">
              Aviso Legal y Términos
            </a>
          </li>
          <li>
            <a href="/cookies" class="hover:text-amber-400 transition-colors">
              Política de Cookies
            </a>
          </li>
          <li>
            <a href="/privacidad#menores" class="text-neutral-400 hover:text-amber-400 transition-colors flex items-center gap-1.5">
              <span>Protección de Menores (+14)</span>
            </a>
          </li>
          <li class="pt-1">
            <button
              type="button"
              id="footer-reopen-cookies"
              class="text-neutral-400 hover:text-amber-400 transition-colors cursor-pointer text-left text-[11px] underline"
            >
              ⚙️ Preferencias de Cookies
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[#181613] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-400 font-sans">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <p>© {new Date().getFullYear()} Acordes Ocultos. Todos los derechos reservados.</p>
        <span class="hidden sm:inline text-neutral-700">•</span>
        <div class="flex items-center gap-3 text-[11px] text-neutral-400">
          <a href="/privacidad" class="hover:underline">Privacidad</a>
          <span>·</span>
          <a href="/aviso-legal" class="hover:underline">Aviso Legal</a>
          <span>·</span>
          <a href="/cookies" class="hover:underline">Cookies</a>
        </div>
      </div>
      <p class="italic font-serif text-neutral-400 text-center md:text-right">
        "Detrás de cada acorde perfecto se oculta una herida o un milagro."
      </p>
    </div>
  </div>
</footer>

<script>
  (function() {
    const btn = document.getElementById('footer-reopen-cookies');
    if (btn) {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('acordes_reopen_cookie_banner'));
      });
    }
  })();
</script>
