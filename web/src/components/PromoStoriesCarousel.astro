---
import type { StoryItem } from '../lib/types';

interface Props {
  stories: StoryItem[];
}

const { stories } = Astro.props;

// Filter only stories that have a valid promotional poster / story teaser
const promoStories = (stories || [])
  .filter(s => Boolean(s.promoPosterUrl))
  // Pin custom promotional posters (high-impact editorial story posters) first, sorted chronologically
  .sort((a, b) => {
    const isCustomA = a.promoPosterUrl?.includes('story_promo') ? 1 : 0;
    const isCustomB = b.promoPosterUrl?.includes('story_promo') ? 1 : 0;
    if (isCustomA !== isCustomB) return isCustomB - isCustomA;
    const timeA = new Date(a.igPublishedAt || a.publishedAt || 0).getTime() || 0;
    const timeB = new Date(b.igPublishedAt || b.publishedAt || 0).getTime() || 0;
    if (timeB !== timeA) return timeB - timeA;
    return (b.views || 0) - (a.views || 0);
  });

if (promoStories.length === 0) return null;
---

<section class="py-14 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-[#201e1a] bg-[#0d0c09] relative overflow-hidden" id="historias-cartelera">
  <!-- Subtle ambient glow background -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-amber-600/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Section Header & Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase bg-amber-500/10 text-amber-300 border border-amber-500/30 mb-3 font-sans">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>⚡ EN HISTORIAS DE INSTAGRAM</span>
          <span class="text-amber-500">•</span>
          <span>FORMATO VERTICAL 9:16</span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight">
          Cartelera & Avances de Historias
        </h2>
        <p class="text-xs sm:text-sm text-neutral-400 mt-2 max-w-2xl font-sans leading-relaxed">
          Pósteres y avances visuales oficiales emitidos en nuestras redes. Haz clic en cualquier tarjeta para sumergirte en la crónica documental completa.
        </p>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          id="promo-carousel-prev"
          aria-label="Desplazar a la izquierda"
          class="w-11 h-11 rounded-full bg-[#181613] hover:bg-[#24201a] border border-[#2e2a24] hover:border-amber-500/50 text-neutral-300 hover:text-amber-300 flex items-center justify-center transition-all shadow-lg shadow-black/50 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="promo-carousel-next"
          aria-label="Desplazar a la derecha"
          class="w-11 h-11 rounded-full bg-[#181613] hover:bg-[#24201a] border border-[#2e2a24] hover:border-amber-500/50 text-neutral-300 hover:text-amber-300 flex items-center justify-center transition-all shadow-lg shadow-black/50 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Container -->
    <div
      id="promo-carousel-track"
      class="flex gap-5 sm:gap-6 overflow-x-auto pb-4 pt-2 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 snap-x snap-mandatory scroll-smooth no-scrollbar"
      style="scrollbar-width: none; -ms-overflow-style: none;"
      tabindex="0"
      role="region"
      aria-label="Carrusel de Carteles de Historias"
    >
      {promoStories.map((item, idx) => (
        <article class="w-64 sm:w-72 md:w-80 shrink-0 snap-start rounded-2xl overflow-hidden border border-[#26231e] bg-[#12100d] shadow-2xl hover:border-amber-500/50 hover:shadow-amber-950/40 transition-all duration-300 group flex flex-col justify-between relative">
          
          <!-- Image Poster Container (Vertical 9:16) -->
          <div class="relative aspect-[9/16] overflow-hidden bg-black select-none">
            <div class="absolute inset-0 z-10 pointer-events-none" data-image-shield="true" aria-hidden="true"></div>
            
            <img
              src={item.promoPosterUrl}
              alt={`Póster oficial de ${item.title}`}
              width="576"
              height="1024"
              loading={idx < 2 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out select-none pointer-events-none"
            />

            <!-- Top Floating Header Badges -->
            <div class="absolute top-3 left-3 right-3 z-20 flex items-center justify-between gap-2 pointer-events-none">
              <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider bg-black/80 backdrop-blur-md text-amber-300 border border-amber-500/40 shadow-lg font-sans">
                {item.categoryLabel}
              </span>

              {item.instagramUrl && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold uppercase bg-gradient-to-r from-purple-900/80 to-pink-900/80 text-white backdrop-blur-md border border-pink-500/30 font-sans shadow-lg">
                  <svg class="w-3 h-3 fill-current text-pink-400" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z"/>
                  </svg>
                  <span>Reel</span>
                </span>
              )}
            </div>

            <!-- Gradient Scrim for Bottom Action Overlay -->
            <div class="absolute inset-0 z-10 bg-gradient-to-t from-black via-black/40 to-transparent opacity-85 group-hover:opacity-95 transition-opacity"></div>

            <!-- Card Bottom Info & CTA Overlay -->
            <div class="absolute bottom-0 left-0 right-0 z-20 p-4 sm:p-5 flex flex-col justify-end space-y-2.5">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-widest text-amber-400 font-sans truncate">
                  {item.artist}
                </p>
                <h3 class="font-serif text-base sm:text-lg font-bold text-white leading-snug line-clamp-2 group-hover:text-amber-200 transition-colors">
                  {item.title}
                </h3>
              </div>

              <!-- Action Buttons -->
              <div class="pt-1 flex items-center gap-2">
                <a
                  href={`/historias/${item.slug}`}
                  class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold font-sans uppercase tracking-wider bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-black shadow-lg shadow-amber-950/50 transition-all transform hover:-translate-y-0.5"
                >
                  <span>Leer Crónica</span>
                  <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>

                {item.instagramUrl && (
                  <a
                    href={item.instagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xl bg-black/70 hover:bg-black text-neutral-300 hover:text-amber-300 border border-neutral-700 hover:border-amber-500/50 transition-colors"
                    title="Ver Reel en Instagram"
                    aria-label={`Ver Reel de ${item.title} en Instagram`}
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function setupPromoCarousel() {
    const track = document.getElementById('promo-carousel-track');
    const prevBtn = document.getElementById('promo-carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('promo-carousel-next') as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const scrollStep = 320;

    const updateControls = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 5;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    };

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollStep, behavior: 'smooth' });
    });

    track.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);

    // Initial check
    setTimeout(updateControls, 100);
  }

  // Setup on page load
  setupPromoCarousel();
  document.addEventListener('astro:page-load', setupPromoCarousel);
</script>
