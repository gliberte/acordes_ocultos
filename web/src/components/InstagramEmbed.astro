---
import InstagramReelFacade from './InstagramReelFacade';

interface Props {
  reelUrl?: string;
  videoUrl?: string;
  tiktokVideoUrl?: string;
  coverUrl?: string;
  title: string;
  artist?: string;
}

const { reelUrl, coverUrl, title, artist } = Astro.props;

// Extract Instagram shortcode if URL provided
let shortcode = '';
if (reelUrl) {
  const match = reelUrl.match(/(?:reel|p)\/([a-zA-Z0-9_-]+)/);
  if (match) {
    shortcode = match[1];
  }
}
---

<div class="space-y-4">
  {shortcode ? (
    <InstagramReelFacade
      client:load
      shortcode={shortcode}
      reelUrl={reelUrl!}
      coverUrl={coverUrl}
      title={title}
      artist={artist}
    />
  ) : (
    /* Coming Soon Poster (No Raw Video Playback to protect Copyright) */
    <div class="flex flex-col items-center w-full max-w-[380px] mx-auto">
      <div class="mb-3 flex items-center justify-between w-full px-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-[11px] uppercase tracking-widest text-amber-400 font-semibold font-mono">
            Estreno Próximamente
          </span>
        </div>
      </div>

      <!-- 9:16 Vertical Poster with Coming Soon Badge -->
      <div class="relative w-full aspect-[9/16] rounded-2xl overflow-hidden bg-black border-2 border-[#383228] shadow-2xl shadow-black/90">
        <img
          src={coverUrl || '/assets/substack_header_banner.jpg'}
          alt={title}
          class="w-full h-full object-cover filter brightness-[0.70]"
          onerror="this.src='/brand/acordes-ocultos-logo.png'"
        />

        <!-- Vignette & Dark Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-black/70 pointer-events-none"></div>

        <!-- Top Badge -->
        <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
          <span class="px-2.5 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider bg-black/85 text-amber-300 border border-amber-500/40 backdrop-blur-md shadow-lg flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            <span>Próximamente</span>
          </span>
          <div class="w-7 h-7 rounded-full bg-black/80 border border-white/15 flex items-center justify-center text-white backdrop-blur-md shadow">
            <svg class="w-3.5 h-3.5 fill-current text-rose-400" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
        </div>

        <!-- Center Notice Content -->
        <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10">
          <div class="w-16 h-16 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-4 shadow-xl backdrop-blur-sm">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="px-3 py-1 rounded-full bg-black/85 border border-amber-500/40 text-amber-300 font-bold text-xs uppercase tracking-wider shadow-md">
            Video Disponible Próximamente
          </span>
          <p class="text-xs text-neutral-300 mt-3 font-sans leading-relaxed max-w-[260px]">
            El video oficial y su historia extendida se publicarán muy pronto en nuestro canal oficial.
          </p>
          <a
            href="https://instagram.com/acordesocultos"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold bg-gradient-to-r from-amber-500 to-amber-600 text-black hover:from-amber-400 hover:to-amber-500 transition-all shadow-lg transform hover:scale-105"
          >
            <span>Seguir en Instagram</span>
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>

        <!-- Bottom Track Details -->
        <div class="absolute bottom-4 left-4 right-4 z-10 space-y-0.5 pointer-events-none">
          {artist && (
            <p class="text-[10px] uppercase font-bold tracking-widest text-amber-400 drop-shadow">
              {artist}
            </p>
          )}
          <h4 class="font-serif text-sm font-bold text-neutral-100 line-clamp-1 drop-shadow">
            {title}
          </h4>
        </div>
      </div>
    </div>
  )}
</div>
