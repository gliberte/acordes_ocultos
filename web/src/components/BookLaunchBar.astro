---
// web/src/components/BookLaunchBar.astro
// Barra sutil en la cabecera anunciando el libro oficial en su semana de lanzamiento
// Incluye miniatura en perspectiva 3D del libro físico con lomo y grosor de 241 páginas
---

<div
  id="book-launch-bar"
  class="relative z-50 w-full bg-gradient-to-r from-[#14100b] via-[#21170d] to-[#14100b] border-b border-amber-500/30 text-neutral-200 shadow-lg shadow-black/40 overflow-hidden transition-all duration-300"
  role="region"
  aria-label="Barra de anuncio: Lanzamiento del libro oficial Acordes Ocultos"
>
  <!-- Ambient subtle golden shimmer -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(245,158,11,0.15)_0%,transparent_70%)] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-1.5 sm:py-2 flex items-center justify-between gap-2.5 sm:gap-4">
    
    <!-- Link principal que envuelve imagen, textos y CTA -->
    <a
      href="/libro"
      class="flex items-center gap-2.5 sm:gap-3.5 flex-1 min-w-0 group hover:opacity-95 transition-opacity py-0.5"
      title="Conoce el Libro Oficial: Acordes Ocultos — Volumen 01"
    >
      <!-- Imagen del Libro en Perspectiva de Libro Físico 3D con la Portada Oficial -->
      <div class="relative shrink-0 flex items-center justify-center">
        <div class="relative h-9 sm:h-11 w-auto aspect-[200/305] rounded-sm overflow-visible drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)] group-hover:scale-105 group-hover:-rotate-1 transition-all duration-300">
          <img
            src="/book/libro-fisico-3d-thumb.webp"
            alt="Libro físico Acordes Ocultos Volumen 1 con portada oficial y 241 páginas"
            width="200"
            height="305"
            class="h-full w-auto object-contain filter contrast-[1.05]"
            loading="eager"
            decoding="async"
          />
        </div>
        <!-- Indicador de novedad pulsante -->
        <span class="absolute -top-1 -right-1 flex h-2 w-2 sm:h-2.5 sm:w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 sm:h-2.5 sm:w-2.5 bg-amber-500"></span>
        </span>
      </div>

      <!-- Textos de anuncio calibrados para desktop y móvil -->
      <div class="flex items-center gap-2 flex-wrap min-w-0">
        <!-- Badge Semana de Lanzamiento -->
        <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/35 shrink-0 font-sans">
          <span>✨</span> Semana de Lanzamiento
        </span>

        <!-- Mensaje principal -->
        <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-sans text-neutral-200 truncate sm:overflow-visible">
          <span class="font-serif font-bold text-amber-300 tracking-wide">
            Libro Oficial Vol. I
          </span>
          <span class="hidden md:inline text-neutral-400">·</span>
          <span class="hidden md:inline text-neutral-300">
            28 relatos documentales (241 págs.)
          </span>
          <span class="text-neutral-400">·</span>
          <span class="text-neutral-300 font-medium">
            Oferta <strong class="text-amber-400 font-bold">$7.99 USD</strong>
          </span>
          <span class="hidden lg:inline text-neutral-400 text-[11px]">
            con código <code class="px-1.5 py-0.2 rounded bg-black/60 border border-amber-500/40 text-amber-300 font-mono text-[10px] font-bold">LANZAMIENTO</code>
          </span>
        </div>
      </div>

      <!-- Botón CTA Desktop -->
      <div class="hidden sm:flex items-center shrink-0 ml-auto mr-1">
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-gradient-to-r from-amber-500 to-amber-400 text-black shadow-sm group-hover:from-amber-400 group-hover:to-amber-300 transition-all transform group-hover:translate-x-0.5">
          <span>Ver Libro</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </a>

    <!-- Botón CTA Móvil -->
    <a
      href="/libro"
      class="sm:hidden shrink-0 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-amber-500 to-amber-400 text-black shadow-sm hover:from-amber-400 hover:to-amber-300 active:scale-95 transition-all"
    >
      Ver →
    </a>

    <!-- Botón para cerrar / descartar sutilmente -->
    <button
      id="close-book-bar-btn"
      type="button"
      aria-label="Cerrar anuncio"
      class="shrink-0 p-1 text-neutral-400 hover:text-amber-300 hover:bg-white/5 rounded transition-colors focus:outline-none focus:ring-1 focus:ring-amber-500/50"
      title="Cerrar anuncio"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    var bar = document.getElementById('book-launch-bar');
    if (!bar) return;

    // Verificar si el usuario ya descartó la barra en la sesión actual
    try {
      if (sessionStorage.getItem('acordes_book_launch_bar_dismissed') === 'true') {
        bar.style.display = 'none';
        return;
      }
    } catch (e) {}

    var closeBtn = document.getElementById('close-book-bar-btn');
    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        bar.style.maxHeight = bar.scrollHeight + 'px';
        requestAnimationFrame(function() {
          bar.style.transition = 'max-height 0.3s ease-out, opacity 0.25s ease-out, padding 0.3s ease-out';
          bar.style.maxHeight = '0px';
          bar.style.opacity = '0';
          bar.style.paddingTop = '0px';
          bar.style.paddingBottom = '0px';
          setTimeout(function() {
            bar.style.display = 'none';
          }, 320);
        });

        try {
          sessionStorage.setItem('acordes_book_launch_bar_dismissed', 'true');
        } catch (e) {}
      });
    }
  })();
</script>
