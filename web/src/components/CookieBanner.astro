---
// CookieBanner.astro - Conforme a AEPD, RGPD y LSSI-CE (Art. 22.2)
---

<div
  id="acordes-cookie-banner"
  hidden
  inert
  aria-hidden="true"
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-lg z-50 transform translate-y-32 opacity-0 pointer-events-none transition-all duration-300 ease-out"
  role="dialog"
  aria-live="polite"
  aria-label="Consentimiento de cookies"
>
  <div class="p-5 sm:p-6 rounded-2xl bg-[#12100d]/95 backdrop-blur-md border border-amber-500/30 shadow-2xl shadow-black/90 text-neutral-300 font-sans">
    
    <div class="flex items-start gap-3 mb-3">
      <span class="text-xl sm:text-2xl shrink-0">🍪</span>
      <div>
        <h3 class="font-serif text-base sm:text-lg font-bold text-white tracking-tight leading-snug">
          Tu Privacidad en Acordes Ocultos
        </h3>
        <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
          Utilizamos cookies técnicas necesarias para el funcionamiento del portal y herramientas de analítica anónima para optimizar la experiencia cultural. Puedes aceptar todas o navegar solo con las necesarias.
        </p>
      </div>
    </div>

    <!-- Actions compliant with AEPD (Equal prominence for Accept / Reject) -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-2 border-t border-[#26221c]">
      <button
        type="button"
        id="cookie-accept-all"
        class="flex-1 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black border border-amber-500 font-bold text-xs uppercase tracking-wider transition-all shadow-md text-center cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300"
      >
        Aceptar todas
      </button>

      <button
        type="button"
        id="cookie-reject-nonessential"
        class="flex-1 px-4 py-2.5 rounded-xl bg-[#1f1b16] hover:bg-[#2a241d] text-amber-300 border border-amber-500/60 hover:border-amber-400 font-bold text-xs uppercase tracking-wider transition-all shadow-md text-center cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300"
      >
        Solo necesarias
      </button>

      <a
        href="/cookies"
        class="px-3 py-2 text-center text-xs text-amber-400 hover:text-amber-300 transition-colors underline sm:no-underline sm:hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300 rounded-lg"
      >
        Política
      </a>
    </div>

  </div>
</div>

<script>
  (function() {
    const banner = document.getElementById('acordes-cookie-banner');
    const btnAccept = document.getElementById('cookie-accept-all');
    const btnReject = document.getElementById('cookie-reject-nonessential');

    const STORAGE_KEY = 'acordes_cookies_consent';
    const META_KEY = 'acordes_cookies_consent_meta';
    const CONSENT_VERSION = '2026-10';

    function showBanner() {
      if (!banner) return;
      banner.removeAttribute('hidden');
      banner.removeAttribute('inert');
      banner.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        banner.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
        banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      });
    }

    function hideBanner() {
      if (!banner) return;
      banner.setAttribute('inert', '');
      banner.setAttribute('aria-hidden', 'true');
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        if (banner.hasAttribute('inert')) {
          banner.setAttribute('hidden', '');
        }
      }, 300);
    }

    function saveChoice(choice: 'accepted' | 'rejected') {
      const meta = {
        choice,
        version: CONSENT_VERSION,
        timestamp: new Date().toISOString()
      };
      localStorage.setItem(STORAGE_KEY, choice);
      localStorage.setItem(META_KEY, JSON.stringify(meta));
      hideBanner();
      window.dispatchEvent(new CustomEvent('acordes_consent_updated', { detail: meta }));
    }

    // Check if choice was already made for current policy version
    const saved = localStorage.getItem(STORAGE_KEY);
    let validVersion = false;
    try {
      const parsedMeta = JSON.parse(localStorage.getItem(META_KEY) || '{}');
      validVersion = parsedMeta && parsedMeta.version === CONSENT_VERSION;
    } catch {
      validVersion = false;
    }

    if (!saved || !validVersion) {
      setTimeout(showBanner, 600);
    }

    if (btnAccept) {
      btnAccept.addEventListener('click', () => saveChoice('accepted'));
    }

    if (btnReject) {
      btnReject.addEventListener('click', () => saveChoice('rejected'));
    }

    // Support reopening from Cookie Policy page or footer
    window.addEventListener('acordes_reopen_cookie_banner', () => {
      showBanner();
    });
  })();
</script>
