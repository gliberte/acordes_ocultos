---
interface Props {
  title: string;
  slug: string;
  hook?: string;
}

const { title, slug, hook } = Astro.props;
const siteUrl = 'https://www.acordesocultos.com';
const fullUrl = `${siteUrl}/historias/${slug}`;
const shareText = `«${title}» — ${hook || 'Descubre la historia oculta detrás de este clásico en Acordes Ocultos:'} ${fullUrl}`;
const tweetText = `«${title}» en @acordesocultos — ${hook || 'Crónica de archivo musical'}`;

const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`;
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(fullUrl)}`;
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(fullUrl)}&text=${encodeURIComponent(shareText)}`;
---

<div class="my-6 p-4 rounded-xl bg-[#12100e] border border-[#26221c] flex flex-col sm:flex-row items-center justify-between gap-4">
  <div class="flex items-center gap-2 text-xs font-sans text-neutral-300">
    <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
    </svg>
    <span class="font-bold uppercase tracking-wider text-[11px]">Compartir este relato:</span>
  </div>

  <div class="flex items-center gap-2 flex-wrap">
    <!-- WhatsApp -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-[#1e2922] text-emerald-400 border border-emerald-800/40 hover:bg-emerald-900/30 hover:border-emerald-500 transition-colors"
      title="Compartir por WhatsApp"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.54 1.849.835 2.795.835h.005c3.181 0 5.768-2.587 5.769-5.766.001-3.182-2.585-5.822-5.774-5.822zm6.985 5.766c-.001 3.847-3.131 6.977-6.979 6.977-1.196 0-2.366-.312-3.395-.904l-3.774.99 1.008-3.68c-.651-1.077-.996-2.316-.995-3.585.001-3.848 3.132-6.978 6.98-6.978 3.849 0 6.98 3.131 6.98 6.978z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- X / Twitter -->
    <a
      href={twitterUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-[#19191d] text-neutral-200 border border-neutral-700 hover:bg-neutral-800 hover:border-neutral-500 transition-colors"
      title="Compartir en X"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>X</span>
    </a>

    <!-- Telegram -->
    <a
      href={telegramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-[#13222e] text-sky-400 border border-sky-800/40 hover:bg-sky-900/30 hover:border-sky-500 transition-colors"
      title="Compartir en Telegram"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
      </svg>
      <span>Telegram</span>
    </a>

    <!-- Copiar Enlace -->
    <button
      type="button"
      id={`copy-share-btn-${slug}`}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-[#1e1c18] text-amber-300 border border-amber-500/30 hover:bg-amber-500/20 hover:border-amber-400 transition-colors cursor-pointer"
      data-url={fullUrl}
      title="Copiar enlace al portapapeles"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id={`copy-share-text-${slug}`}>Copiar</span>
    </button>
  </div>
</div>

<script define:vars={{ slug, fullUrl }}>
  (function() {
    const btn = document.getElementById(`copy-share-btn-${slug}`);
    const text = document.getElementById(`copy-share-text-${slug}`);
    if (btn && text) {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(fullUrl);
          text.textContent = '¡Copiado!';
          btn.classList.add('bg-emerald-950', 'text-emerald-300', 'border-emerald-500');
          setTimeout(() => {
            text.textContent = 'Copiar';
            btn.classList.remove('bg-emerald-950', 'text-emerald-300', 'border-emerald-500');
          }, 2000);
        } catch {
          // Fallback
          const ta = document.createElement('textarea');
          ta.value = fullUrl;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          text.textContent = '¡Copiado!';
          setTimeout(() => { text.textContent = 'Copiar'; }, 2000);
        }
      });
    }
  })();
</script>
