---
import type { StoryItem } from '../lib/types';
import { getCategoryInfo } from '../lib/categories';

interface Props {
  story: StoryItem;
}

const { story } = Astro.props;
const category = getCategoryInfo(story.category);

const formattedViews = story.views && story.views > 0
  ? story.views >= 1_000_000
    ? `${(story.views / 1_000_000).toFixed(1)}M`
    : story.views >= 10_000
      ? `${Math.round(story.views / 1_000)}K`
      : story.views.toLocaleString()
  : null;
---
<article class="group relative bg-[#131210] rounded-xl overflow-hidden border border-[#26231e] hover:border-amber-500/50 transition-all duration-300 flex flex-col hover:shadow-xl hover:shadow-amber-950/20 hover:-translate-y-1">
  <!-- Cover & Media Preview -->
  <div class="relative aspect-[4/5] sm:aspect-[9/14] w-full overflow-hidden bg-neutral-900">
    <img
      src={story.coverUrl}
      alt={story.title}
      loading="lazy"
      decoding="async"
      width="480"
      height="854"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
      onerror="this.src='/brand/acordes-ocultos-logo-sm.webp'"
    />
    
    <!-- Dark Vignette Gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#131210] via-transparent to-black/40"></div>

    <!-- Category Badge -->
    <div class="absolute top-3 left-3 z-10">
      <span class={`inline-block px-2.5 py-1 text-[11px] font-semibold tracking-wider uppercase rounded-full border backdrop-blur-md ${category.badgeClass}`}>
        {category.name}
      </span>
    </div>

    <!-- Media Badges (Top Right) -->
    <div class="absolute top-3 right-3 flex items-center gap-1.5 z-10">
      {story.isLatestReel ? (
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-gradient-to-r from-amber-400 to-amber-500 text-black border border-amber-300 shadow-lg shadow-amber-500/40 animate-pulse font-sans">
          ⚡ ÚLTIMO REEL
        </span>
      ) : formattedViews ? (
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-black/85 text-amber-300 border border-amber-500/40 backdrop-blur-md shadow font-mono">
          <svg class="w-3 h-3 text-amber-400 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {formattedViews}
        </span>
      ) : story.instagramUrl ? (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-black/70 text-amber-300 border border-amber-500/40 backdrop-blur-sm shadow">
          <svg class="w-3 h-3 text-amber-400 fill-current" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Reel
        </span>
      ) : (
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-black/80 text-amber-300/90 border border-amber-500/30 backdrop-blur-sm shadow">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          Próximamente
        </span>
      )}
    </div>

    <!-- Floating Action on Hover -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
      {story.instagramUrl ? (
        <div class="w-14 h-14 rounded-full bg-amber-500/90 text-black flex items-center justify-center shadow-lg transform scale-75 group-hover:scale-100 transition-transform duration-300">
          <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
      ) : (
        <div class="px-3.5 py-1.5 rounded-full bg-black/90 text-amber-300 border border-amber-500/40 text-xs font-semibold uppercase tracking-wider shadow-lg transform scale-90 group-hover:scale-100 transition-transform duration-300 backdrop-blur-md">
          Próximamente
        </div>
      )}
    </div>
  </div>

  <!-- Content & Info -->
  <div class="p-5 flex flex-col flex-grow">
    <!-- Artist -->
    {story.artist && (
      <p class="text-xs uppercase tracking-widest text-amber-500 font-semibold mb-1 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        <span>{story.artist}</span>
      </p>
    )}

    <!-- Title -->
    <h3 class="font-serif text-lg font-bold text-neutral-100 group-hover:text-amber-300 transition-colors line-clamp-2 mb-2 leading-snug">
      <a href={`/historias/${story.slug}`} class="before:absolute before:inset-0">
        {story.title}
      </a>
    </h3>

    <!-- Summary Snippet -->
    {story.summary && (
      <p class="text-xs text-neutral-400 font-sans line-clamp-2 mb-4 leading-relaxed flex-grow">
        {story.summary.replace(/#\S+/g, '').replace(/https?:\/\/\S+/g, '')}
      </p>
    )}

    <!-- Card Bottom Metadata -->
    <div class="pt-3 border-t border-[#201d19] flex items-center justify-between text-[11px] text-neutral-400 mt-auto">
      <span>{story.instagramUrl ? (story.durationSeconds ? `${story.durationSeconds} seg` : 'Microhistoria') : 'Próximo estreno'}</span>
      <span class="text-amber-500/80 group-hover:text-amber-400 font-medium flex items-center gap-1">
        {story.instagramUrl ? 'Leer relato →' : 'Ver adelanto →'}
      </span>
    </div>
  </div>
</article>
